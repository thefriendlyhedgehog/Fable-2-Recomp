+namespace {
+// Parses a decimal or 0x-prefixed hexadecimal unsigned integer.
+bool ParseForcedReadbackNumber(std::string_view text, uint64_t& value_out) {
+  int base = 10;
+  if (text.size() > 2 && text[0] == '0' && (text[1] == 'x' || text[1] == 'X')) {
+    text.remove_prefix(2);
+    base = 16;
+  }
+  if (text.empty()) {
+    return false;
+  }
+  uint64_t value = 0;
+  for (char c : text) {
+    uint32_t digit;
+    if (c >= '0' && c <= '9') {
+      digit = uint32_t(c - '0');
+    } else if (base == 16 && c >= 'a' && c <= 'f') {
+      digit = uint32_t(c - 'a' + 10);
+    } else if (base == 16 && c >= 'A' && c <= 'F') {
+      digit = uint32_t(c - 'A' + 10);
+    } else {
+      return false;
+    }
+    value = value * uint64_t(base) + digit;
+    if (value > UINT32_MAX) {
+      return false;
+    }
+  }
+  value_out = value;
+  return true;
+}
+
+std::string_view TrimForcedReadbackToken(std::string_view text) {
+  while (!text.empty() && (text.front() == ' ' || text.front() == '\t')) {
+    text.remove_prefix(1);
+  }
+  while (!text.empty() && (text.back() == ' ' || text.back() == '\t')) {
+    text.remove_suffix(1);
+  }
+  return text;
+}
+
+// Formats with the same memory layout as a resolve destination.
+xenos::ColorFormat GetForcedReadbackBaseFormat(xenos::ColorFormat format) {
+  switch (format) {
+    case xenos::ColorFormat::k_8_8_8_8_A:
+    case xenos::ColorFormat::k_8_8_8_8_AS_16_16_16_16:
+      return xenos::ColorFormat::k_8_8_8_8;
+    case xenos::ColorFormat::k_2_10_10_10_AS_16_16_16_16:
+      return xenos::ColorFormat::k_2_10_10_10;
+    case xenos::ColorFormat::k_10_11_11_AS_16_16_16_16:
+      return xenos::ColorFormat::k_10_11_11;
+    case xenos::ColorFormat::k_11_11_10_AS_16_16_16_16:
+      return xenos::ColorFormat::k_11_11_10;
+    default:
+      return format;
+  }
+}
+
+bool ParseForcedReadbackFormat(std::string_view name, xenos::ColorFormat& format_out) {
+  static constexpr std::pair<std::string_view, xenos::ColorFormat> kFormats[] = {
+      {"8", xenos::ColorFormat::k_8},
+      {"1_5_5_5", xenos::ColorFormat::k_1_5_5_5},
+      {"5_6_5", xenos::ColorFormat::k_5_6_5},
+      {"6_5_5", xenos::ColorFormat::k_6_5_5},
+      {"8_8_8_8", xenos::ColorFormat::k_8_8_8_8},
+      {"2_10_10_10", xenos::ColorFormat::k_2_10_10_10},
+      {"8_A", xenos::ColorFormat::k_8_A},
+      {"8_B", xenos::ColorFormat::k_8_B},
+      {"8_8", xenos::ColorFormat::k_8_8},
+      {"8_8_8_8_A", xenos::ColorFormat::k_8_8_8_8_A},
+      {"4_4_4_4", xenos::ColorFormat::k_4_4_4_4},
+      {"10_11_11", xenos::ColorFormat::k_10_11_11},
+      {"11_11_10", xenos::ColorFormat::k_11_11_10},
+      {"16", xenos::ColorFormat::k_16},
+      {"16_16", xenos::ColorFormat::k_16_16},
+      {"16_16_16_16", xenos::ColorFormat::k_16_16_16_16},
+      {"16_FLOAT", xenos::ColorFormat::k_16_FLOAT},
+      {"16_16_FLOAT", xenos::ColorFormat::k_16_16_FLOAT},
+      {"16_16_16_16_FLOAT", xenos::ColorFormat::k_16_16_16_16_FLOAT},
+      {"32_FLOAT", xenos::ColorFormat::k_32_FLOAT},
+      {"32_32_FLOAT", xenos::ColorFormat::k_32_32_FLOAT},
+      {"32_32_32_32_FLOAT", xenos::ColorFormat::k_32_32_32_32_FLOAT},
+      {"8_8_8_8_AS_16_16_16_16", xenos::ColorFormat::k_8_8_8_8_AS_16_16_16_16},
+      {"2_10_10_10_AS_16_16_16_16", xenos::ColorFormat::k_2_10_10_10_AS_16_16_16_16},
+      {"10_11_11_AS_16_16_16_16", xenos::ColorFormat::k_10_11_11_AS_16_16_16_16},
+      {"11_11_10_AS_16_16_16_16", xenos::ColorFormat::k_11_11_10_AS_16_16_16_16},
+  };
+  if (name.size() > 2 && (name[0] == 'k' || name[0] == 'K') && name[1] == '_') {
+    name.remove_prefix(2);
+  }
+  for (const auto& [format_name, format] : kFormats) {
+    if (name.size() == format_name.size() &&
+        std::equal(name.begin(), name.end(), format_name.begin(), [](char a, char b) {
+          return (a >= 'a' && a <= 'z' ? char(a - 'a' + 'A') : a) == b;
+        })) {
+      format_out = format;
+      return true;
+    }
+  }
+  uint64_t number;
+  if (ParseForcedReadbackNumber(name, number) && number < 64) {
+    format_out = xenos::ColorFormat(number);
+    return true;
+  }
+  return false;
+}
+}  // namespace
+
+CommandProcessor::ForcedReadbackResolve CommandProcessor::ShouldForceReadbackResolve(
+    const ForcedReadbackResolveQuery& query, std::string* filtered_reason) const {
+  const std::string& list = REXCVAR_GET(readback_resolve_force_addresses);
+  ForcedReadbackResolve result = ForcedReadbackResolve::kNo;
+  size_t pos = 0;
+  while (pos < list.size()) {
+    size_t end = list.find(',', pos);
+    if (end == std::string::npos) {
+      end = list.size();
+    }
+    std::string_view entry =
+        TrimForcedReadbackToken(std::string_view(list.data() + pos, end - pos));
+    pos = end + 1;
+    if (entry.empty()) {
+      continue;
+    }
+    std::string_view rest = entry;
+    size_t colon = rest.find(':');
+    uint64_t address;
+    if (!ParseForcedReadbackNumber(TrimForcedReadbackToken(rest.substr(0, colon)), address)) {
+      continue;
+    }
+    // 64 KiB by default: the Fable II hero/dog target 0x12704000 has other
+    // resolve targets 128 KiB away (0x12724000, ...); a wider window reads
+    // those back too.
+    uint64_t span = uint64_t(1) << 16;
+    bool want_color = false, want_depth = false, want_blit = false;
+    bool want_format = false, entry_valid = true;
+    xenos::ColorFormat format = xenos::ColorFormat::k_8_8_8_8;
+    while (colon != std::string_view::npos) {
+      rest.remove_prefix(colon + 1);
+      colon = rest.find(':');
+      std::string_view qualifier = TrimForcedReadbackToken(rest.substr(0, colon));
+      if (qualifier == "color") {
+        want_color = true;
+      } else if (qualifier == "depth") {
+        want_depth = true;
+      } else if (qualifier == "blit") {
+        want_blit = true;
+      } else if (qualifier.substr(0, 4) == "fmt=") {
+        want_format = ParseForcedReadbackFormat(qualifier.substr(4), format);
+        entry_valid &= want_format;
+      } else if (qualifier.substr(0, 5) == "span=") {
+        entry_valid &= ParseForcedReadbackNumber(qualifier.substr(5), span) && span != 0;
+      } else {
+        entry_valid = false;
+      }
+    }
+    if (!entry_valid) {
+      static bool invalid_entry_logged = false;
+      if (!invalid_entry_logged) {
+        invalid_entry_logged = true;
+        REXGPU_WARN("readback_resolve_force_addresses: ignoring malformed entry '{}'", entry);
+      }
+      continue;
+    }
+    if (query.dest_base < address || uint64_t(query.dest_base) >= address + span) {
+      continue;
+    }
+    const char* rejection = nullptr;
+    if (want_color && query.copying_depth) {
+      rejection = "a depth resolve";
+    } else if (want_depth && !query.copying_depth) {
+      rejection = "a color resolve";
+    } else if (want_format &&
+               (query.copying_depth || GetForcedReadbackBaseFormat(query.dest_format) !=
+                                           GetForcedReadbackBaseFormat(format))) {
+      rejection = "another destination format";
+    } else if (want_blit && !(query.draw_indx_2 &&
+                              query.primitive_type == xenos::PrimitiveType::kRectangleList &&
+                              query.index_count == 3)) {
+      rejection = "not a PM4_DRAW_INDX_2 3-index rectangle-list blit";
+    }
+    if (!rejection) {
+      return ForcedReadbackResolve::kYes;
+    }
+    if (result == ForcedReadbackResolve::kNo) {
+      result = ForcedReadbackResolve::kFiltered;
+      if (filtered_reason) {
+        *filtered_reason = fmt::format(
+            "entry '{}' does not match ({}): {} resolve, destination format {}, {} with "
+            "primitive type {} and {} indices",
+            entry, rejection, query.copying_depth ? "depth" : "color", uint32_t(query.dest_format),
+            query.draw_indx_2 ? "PM4_DRAW_INDX_2" : "PM4_DRAW_INDX", uint32_t(query.primitive_type),
+            query.index_count);
+      }
+    }
+  }
+  return result;
+}
