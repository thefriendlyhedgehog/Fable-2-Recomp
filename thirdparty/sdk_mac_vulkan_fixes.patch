+uint32_t RenderTargetCache::GetClearQuadRenderTargets(
+    reg::RB_DEPTHCONTROL normalized_depth_control, uint32_t normalized_color_mask,
+    uint32_t depth_and_color_rts_used_bits, const Shader& vertex_shader,
+    Transfer::Rectangle& rectangle_out,
+    DrawExtentEstimator::RectangleCoverageDetails* details_out) {
+  if (!REXCVAR_GET(clear_quad_transfer_cutout) || !depth_and_color_rts_used_bits) {
+    return 0;
+  }
+  const RegisterFile& regs = register_file();
+  using xenos::CompareFunction;
+  using xenos::StencilOp;
+  // Every sample of every pixel the rectangle covers gets a value: rasterized
+  // as filled, not culled, all samples, no alpha test, alpha to coverage or
+  // kill.
+  auto pa_su_sc_mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  auto rb_colorcontrol = regs.Get<reg::RB_COLORCONTROL>();
+  const Shader* pixel_shader = update_pixel_shader_;
+  if (pa_su_sc_mode_cntl.cull_front || pa_su_sc_mode_cntl.cull_back ||
+      pa_su_sc_mode_cntl.poly_mode != xenos::PolygonModeEnable::kDisabled ||
+      (regs[XE_GPU_REG_PA_SC_AA_MASK] & 0xF) != 0xF ||
+      (rb_colorcontrol.alpha_test_enable &&
+       rb_colorcontrol.alpha_func != CompareFunction::kAlways) ||
+      rb_colorcontrol.alpha_to_mask_enable || (pixel_shader && pixel_shader->kills_pixels())) {
+    return 0;
+  }
+  // Depth and stencil tests that always pass (for color to be written
+  // everywhere).
+  bool depth_test_passes =
+      !normalized_depth_control.z_enable || normalized_depth_control.zfunc == CompareFunction::kAlways;
+  bool stencil_test_passes =
+      !normalized_depth_control.stencil_enable ||
+      (normalized_depth_control.stencilfunc == CompareFunction::kAlways &&
+       (!normalized_depth_control.backface_enable ||
+        normalized_depth_control.stencilfunc_bf == CompareFunction::kAlways));
+  if (!depth_test_passes || !stencil_test_passes) {
+    return 0;
+  }
+  uint32_t rts = 0;
+  // Depth / stencil: both replaced.
+  if (depth_and_color_rts_used_bits & 1) {
+    bool stencil_replaced =
+        normalized_depth_control.stencil_enable &&
+        normalized_depth_control.stencilzpass == StencilOp::kReplace &&
+        regs.Get<reg::RB_STENCILREFMASK>().stencilwritemask == 0xFF &&
+        (!normalized_depth_control.backface_enable ||
+         (normalized_depth_control.stencilzpass_bf == StencilOp::kReplace &&
+          reg::RB_STENCILREFMASK{regs[XE_GPU_REG_RB_STENCILREFMASK_BF]}.stencilwritemask ==
+              0xFF));
+    if (normalized_depth_control.z_enable && normalized_depth_control.z_write_enable &&
+        stencil_replaced) {
+      rts |= 1;
+    }
+  }
+  // Color: all components written, no blending.
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    if (!(depth_and_color_rts_used_bits & (uint32_t(1) << (1 + i)))) {
+      continue;
+    }
+    if (pixel_shader && pixel_shader->writes_color_target(int(i)) &&
+        ((normalized_color_mask >> (4 * i)) & 0xF) == 0xF &&
+        (regs[reg::RB_BLENDCONTROL::rt_register_indices[i]] & 0x1FFF1FFF) == 0x00010001) {
+      rts |= uint32_t(1) << (1 + i);
+    }
+  }
+  if (!rts) {
+    return 0;
+  }
+  int32_t x0, y0, x1, y1;
+  if (!draw_extent_estimator_.EstimateRectangleCoverage(vertex_shader, x0, y0, x1, y1,
+                                                        details_out)) {
+    return 0;
+  }
+  rectangle_out.x_pixels = uint32_t(x0);
+  rectangle_out.y_pixels = uint32_t(y0);
+  rectangle_out.width_pixels = uint32_t(x1 - x0);
+  rectangle_out.height_pixels = uint32_t(y1 - y0);
+  return rts;
+}
