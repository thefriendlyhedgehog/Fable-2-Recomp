+  // rule: the left and top edges included); with MSAA, whole pixels within it
+  // (all of their samples).
+  int32_t x0, x1, y0, y1;
+  bool msaa = regs.Get<reg::RB_SURFACE_INFO>().msaa_samples != xenos::MsaaSamples::k1X;
+  // With MSAA, the samples aren't at pixel centers: the whole pixels within
+  // the rectangle are exactly the covered ones only if its edges are on pixel
+  // edges.
+  auto is_integral = [](float v) { return v == std::floor(v); };
+  bool exact = !msaa || (is_integral(min_x) && is_integral(max_x) && is_integral(min_y) &&
+                         is_integral(max_y));
+  if (!msaa) {
+    x0 = int32_t(std::ceil(min_x - 0.5f));
+    x1 = int32_t(std::ceil(max_x - 0.5f));
+    y0 = int32_t(std::ceil(min_y - 0.5f));
+    y1 = int32_t(std::ceil(max_y - 0.5f));
+  } else {
+    x0 = int32_t(std::ceil(min_x));
+    x1 = int32_t(std::floor(max_x));
+    y0 = int32_t(std::ceil(min_y));
+    y1 = int32_t(std::floor(max_y));
+  }
+
+  // Scissor.
+  auto pa_sc_window_scissor_tl = regs.Get<reg::PA_SC_WINDOW_SCISSOR_TL>();
+  auto pa_sc_window_scissor_br = regs.Get<reg::PA_SC_WINDOW_SCISSOR_BR>();
+  int32_t scissor_x0 = int32_t(pa_sc_window_scissor_tl.tl_x);
+  int32_t scissor_y0 = int32_t(pa_sc_window_scissor_tl.tl_y);
+  int32_t scissor_x1 = int32_t(pa_sc_window_scissor_br.br_x);
+  int32_t scissor_y1 = int32_t(pa_sc_window_scissor_br.br_y);
+  if (!pa_sc_window_scissor_tl.window_offset_disable) {
+    scissor_x0 += pa_sc_window_offset.window_x_offset;
+    scissor_y0 += pa_sc_window_offset.window_y_offset;
+    scissor_x1 += pa_sc_window_offset.window_x_offset;
+    scissor_y1 += pa_sc_window_offset.window_y_offset;
+  }
+  auto pa_sc_screen_scissor_tl = regs.Get<reg::PA_SC_SCREEN_SCISSOR_TL>();
+  auto pa_sc_screen_scissor_br = regs.Get<reg::PA_SC_SCREEN_SCISSOR_BR>();
+  x0 = std::max(x0, std::max(scissor_x0, int32_t(pa_sc_screen_scissor_tl.tl_x)));
+  y0 = std::max(y0, std::max(scissor_y0, int32_t(pa_sc_screen_scissor_tl.tl_y)));
+  x1 = std::min(x1, std::min(scissor_x1, int32_t(pa_sc_screen_scissor_br.br_x)));
+  y1 = std::min(y1, std::min(scissor_y1, int32_t(pa_sc_screen_scissor_br.br_y)));
+
+  // Viewport (whole pixels within it), if clipping.
+  if (!regs.Get<reg::PA_CL_CLIP_CNTL>().clip_disable) {
+    float viewport_x0 = x_offset - std::abs(x_scale) + pixel_offset_x;
+    float viewport_x1 = x_offset + std::abs(x_scale) + pixel_offset_x;
+    float viewport_y0 = y_offset - std::abs(y_scale) + pixel_offset_y;
+    float viewport_y1 = y_offset + std::abs(y_scale) + pixel_offset_y;
+    // Exact only if clipping doesn't cut the rectangle off between pixel
+    // edges.
+    int32_t viewport_x0_pixels = int32_t(std::ceil(viewport_x0));
+    int32_t viewport_y0_pixels = int32_t(std::ceil(viewport_y0));
+    int32_t viewport_x1_pixels = int32_t(std::floor(viewport_x1));
+    int32_t viewport_y1_pixels = int32_t(std::floor(viewport_y1));
+    if ((viewport_x0_pixels > x0 && !is_integral(viewport_x0)) ||
+        (viewport_y0_pixels > y0 && !is_integral(viewport_y0)) ||
+        (viewport_x1_pixels < x1 && !is_integral(viewport_x1)) ||
+        (viewport_y1_pixels < y1 && !is_integral(viewport_y1))) {
+      exact = false;
+    }
+    x0 = std::max(x0, viewport_x0_pixels);
+    y0 = std::max(y0, viewport_y0_pixels);
+    x1 = std::min(x1, viewport_x1_pixels);
+    y1 = std::min(y1, viewport_y1_pixels);
+  }
+
+  x0 = std::max(x0, int32_t(0));
+  y0 = std::max(y0, int32_t(0));
+  if (x0 >= x1 || y0 >= y1) {
+    return false;
+  }
+  x0_out = x0;
+  y0_out = y0;
+  x1_out = x1;
+  y1_out = y1;
+  if (details_out) {
+    RectangleCoverageDetails& details = *details_out;
+    details = RectangleCoverageDetails();
+    details.exact = exact;
+    if (zs[0] == zs[1] && zs[1] == zs[2]) {
+      float z_scale = pa_cl_vte_cntl.vport_z_scale_ena
+                          ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_ZSCALE)
+                          : 1.0f;
+      float z_offset = pa_cl_vte_cntl.vport_z_offset_ena
+                           ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_ZOFFSET)
+                           : 0.0f;
+      details.z = zs[0] * z_scale + z_offset;
+      if (clip_disabled) {
+        // Clamped to the viewport depth range, 0 to 1 without clipping.
+        details.z = std::min(std::max(details.z, 0.0f), 1.0f);
+      }
+      details.z_uniform = true;
+    }
+    details.written_interpolators = written_interpolators;
+    for (uint32_t i = 0; i < xenos::kMaxInterpolators; ++i) {
+      if (!(written_interpolators & (uint32_t(1) << i))) {
+        continue;
+      }
+      if (!std::memcmp(interpolators[0][i], interpolators[1][i], sizeof(float) * 4) &&
+          !std::memcmp(interpolators[0][i], interpolators[2][i], sizeof(float) * 4)) {
+        details.uniform_interpolators |= uint32_t(1) << i;
+        std::memcpy(details.interpolators[i], interpolators[0][i], sizeof(float) * 4);
+      }
+    }
+  }
+  return true;
+}
