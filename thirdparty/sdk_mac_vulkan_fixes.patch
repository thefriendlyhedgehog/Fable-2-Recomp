+// ranges: (start, end) pairs.
+bool RangesOverlap(const std::vector<std::pair<uint32_t, uint32_t>>& ranges, uint32_t start,
+                   uint32_t end) {
+  if (start >= end) {
+    return false;
+  }
+  for (const std::pair<uint32_t, uint32_t>& range : ranges) {
+    if (range.first < end && start < range.second) {
+      return true;
+    }
+  }
+  return false;
+}
