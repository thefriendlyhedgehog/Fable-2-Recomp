+VkBuffer VulkanCommandProcessor::GetQuadPatchIndexBuffer(uint32_t grid_size,
+                                                         uint32_t diagonals) {
+  // Grid points y * (N + 1) + x; each cell is split along a diagonal as in
+  // the non-indexed quad patch vertex shader (vulkan_quad_patch_diagonals):
+  // (1,0)-(0,1) into (0,0) (1,0) (0,1) and (1,0) (1,1) (0,1), or (0,0)-(1,1)
+  // into (0,0) (1,0) (1,1) and (0,0) (1,1) (0,1).
+  if (grid_size < 1 || grid_size > 64) {
+    return VK_NULL_HANDLE;
+  }
+  uint32_t key = grid_size | (diagonals << 8);
+  auto it = quad_patch_index_buffers_.find(key);
+  if (it != quad_patch_index_buffers_.end()) {
+    return it->second.first;
+  }
+  std::vector<uint16_t> indices;
+  indices.reserve(grid_size * grid_size * 6);
+  uint32_t points = grid_size + 1;
+  uint32_t half = grid_size >> 1;
+  for (uint32_t y = 0; y < grid_size; ++y) {
+    for (uint32_t x = 0; x < grid_size; ++x) {
+      bool same_quarter_sides = (x < half) == (y < half);
+      bool main_diagonal = diagonals == 1 || (diagonals == 2 && same_quarter_sides) ||
+                           (diagonals == 3 && !same_quarter_sides);
+      auto point = [&](uint32_t dx, uint32_t dy) {
+        return uint16_t((y + dy) * points + (x + dx));
+      };
+      if (main_diagonal) {
+        indices.insert(indices.end(), {point(0, 0), point(1, 0), point(1, 1), point(0, 0),
+                                       point(1, 1), point(0, 1)});
+      } else {
+        indices.insert(indices.end(), {point(0, 0), point(1, 0), point(0, 1), point(1, 0),
+                                       point(1, 1), point(0, 1)});
+      }
+    }
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  VkDeviceSize size = VkDeviceSize(indices.size() * sizeof(uint16_t));
+  VkBuffer buffer;
+  VkDeviceMemory memory;
+  uint32_t memory_type;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          vulkan_device, size, VK_BUFFER_USAGE_INDEX_BUFFER_BIT,
+          ui::vulkan::util::MemoryPurpose::kUpload, buffer, memory, &memory_type)) {
+    REXGPU_ERROR("VulkanCommandProcessor: Failed to create a quad patch index buffer");
+    return VK_NULL_HANDLE;
+  }
+  void* mapping;
+  if (dfn.vkMapMemory(device, memory, 0, VK_WHOLE_SIZE, 0, &mapping) != VK_SUCCESS) {
+    dfn.vkDestroyBuffer(device, buffer, nullptr);
+    dfn.vkFreeMemory(device, memory, nullptr);
+    return VK_NULL_HANDLE;
+  }
+  std::memcpy(mapping, indices.data(), size_t(size));
+  ui::vulkan::util::FlushMappedMemoryRange(vulkan_device, memory, memory_type);
+  dfn.vkUnmapMemory(device, memory);
+  quad_patch_index_buffers_.emplace(key, std::make_pair(buffer, memory));
+  return buffer;
+}
