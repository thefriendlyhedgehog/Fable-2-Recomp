+std::vector<TextureCache::TextureKey> TextureCache::GetTextureKeysAtBasePage(
+    uint32_t base_page) const {
+  std::vector<TextureKey> keys;
+  for (const auto& [key, texture] : textures_) {
+    if (key.base_page == base_page) {
+      keys.push_back(key);
+    }
+  }
+  return keys;
+}
+
+std::unique_ptr<TextureCache::Texture> TextureCache::TakeTextureOutOfCache(
+    const TextureKey& key) {
+  auto found_texture_it = textures_.find(key);
+  if (found_texture_it == textures_.end()) {
+    return nullptr;
+  }
+  std::unique_ptr<Texture> texture = std::move(found_texture_it->second);
+  textures_.erase(found_texture_it);
+  texture->RemoveFromUsageList();
+  ResetTextureBindings();
+  COUNT_profile_set("gpu/texture_cache/textures", textures_.size());
+  return texture;
+}
