+void VulkanCommandProcessor::BeginTimedSpan(std::string label) {
+  if (!gpu_pass_time_frame_ || timed_span_open_ || !submission_open_) {
+    return;
+  }
+  // Timestamps outside render passes only (the span's commands are).
+  EndRenderPass();
+  PassLogEntry& entry = pass_log_current_.emplace_back();
+  entry.target = std::move(label);
+  entry.timed_span = true;
+  deferred_command_buffer_.CmdTimedSpanBegin();
+  timed_span_open_ = true;
+}
+
+void VulkanCommandProcessor::EndTimedSpan() {
+  if (!timed_span_open_) {
+    return;
+  }
+  deferred_command_buffer_.CmdTimedSpanEnd();
+  timed_span_open_ = false;
+}
