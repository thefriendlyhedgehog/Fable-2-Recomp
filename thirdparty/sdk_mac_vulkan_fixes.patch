diff --git a/src/graphics/shaders/texture_load_to_image.cs.glsl b/src/graphics/shaders/texture_load_to_image.cs.glsl
new file mode 100644
index 0000000..e3416c5
--- /dev/null
+++ b/src/graphics/shaders/texture_load_to_image.cs.glsl
@@ -0,0 +1,189 @@
+// Texture loads writing straight into the image (vulkan_texture_load_to_image)
+// instead of a scratch buffer copied to the image afterwards: the same
+// untiling and endian swaps as texture_load_8bpb / 16bpb / 32bpb / 64bpb /
+// depth_float / r5g5b5a1_b5g5r5a1 (non-scaled, 2D or one 3D slice of blocks of
+// 1x1 texels), storing raw texel bits through an unsigned integer view of the
+// same size (r8ui, r16ui, r32ui, rg32ui), so the image gets the same bits as
+// from the copy.
+//
+// Built by tools/build_texture_load_image_shaders.sh with:
+//   BPB_LOG2: 0 (8bpb), 1 (16bpb), 2 (32bpb), 3 (64bpb).
+//   CONVERT: 0 (none), 1 (24-bit float depth to 32-bit float, 32bpb),
+//            2 (R5G5B5A1 to B5G5R5A1, 16bpb).
+#version 450
+
+#ifndef BPB_LOG2
+#error BPB_LOG2 must be defined
+#endif
+#ifndef CONVERT
+#define CONVERT 0
+#endif
+
+// Blocks per thread along X, as in the buffer variants: 16 for 8bpb and
+// 16bpb, 8 for 32bpb, 4 for 64bpb.
+#if BPB_LOG2 <= 1
+#define X_BLOCKS_LOG2 4
+#elif BPB_LOG2 == 2
+#define X_BLOCKS_LOG2 3
+#else
+#define X_BLOCKS_LOG2 2
+#endif
+
+layout(local_size_x = 4, local_size_y = 32, local_size_z = 1) in;
+
+layout(push_constant) uniform LoadConstants {
+  uint is_tiled_3d_endian_scale;
+  uint guest_offset;
+  uint guest_pitch_aligned;
+  uint guest_z_stride_block_rows_aligned;
+  uvec3 size_blocks;
+  uint host_offset;
+  uint host_pitch;
+  uint height_texels;
+} c;
+
+#if BPB_LOG2 == 0
+layout(set = 1, binding = 0, std430) readonly buffer Source { uvec2 data[]; } source;
+layout(set = 0, binding = 0, r8ui) uniform writeonly uimage2D dest;
+#else
+layout(set = 1, binding = 0, std430) readonly buffer Source { uvec4 data[]; } source;
+#if BPB_LOG2 == 1
+layout(set = 0, binding = 0, r16ui) uniform writeonly uimage2D dest;
+#elif BPB_LOG2 == 2
+layout(set = 0, binding = 0, r32ui) uniform writeonly uimage2D dest;
+#else
+layout(set = 0, binding = 0, rg32ui) uniform writeonly uimage2D dest;
+#endif
+#endif
+
+// Byte offset of a block in the guest memory (texture_address.xesli).
+int GuestOffset(ivec3 p) {
+  int bpb_log2 = BPB_LOG2;
+  if ((c.is_tiled_3d_endian_scale & 1u) != 0u) {
+    if ((c.is_tiled_3d_endian_scale & 2u) != 0u) {
+      int z4 = p.z >> 2;
+      int macro = (((p.x & 7) + ((p.y & 6) << 2)) << (bpb_log2 + 6)) >> 6;
+      int bank = ((p.y >> 3) + z4) & 1;
+      int pipe = bank + ((((p.x >> 3) + (bank << 1)) & 3) << 1);
+      int offset =
+          (((((((((p.x >> 5) + (((p.y >> 4) + (z4 * int(c.guest_z_stride_block_rows_aligned >> 4u))) *
+                                 int(c.guest_pitch_aligned >> 5u)))
+                 << (bpb_log2 + 6)) &
+                268435455)
+               << 1) +
+              (macro & -16))
+             << 1) +
+            (macro & 15)) +
+           ((p.z & 3) << (bpb_log2 + 6))) +
+          ((p.y & 1) << 4);
+      return ((((((((pipe & 1) << 3) + ((offset >> 6) & 7)) << 3) + (pipe & -2)) << 2) +
+               (offset & -512))
+              << 3) +
+             (offset & 63);
+    }
+    int micro = ((p.x & 7) + ((p.y & 14) << 2)) << bpb_log2;
+    int offset = (((((p.x >> 5) + ((p.y >> 5) * int(c.guest_pitch_aligned >> 5u)))
+                    << (bpb_log2 + 7)) +
+                   ((micro & -16) << 1)) +
+                  (micro & 15)) +
+                 ((p.y & 1) << 4);
+    return (((((offset & -512) << 3) + ((p.y & 16) << 7)) + ((offset & 448) << 2)) +
+            (((((p.y & 8) >> 2) + (p.x >> 3)) & 3) << 6)) +
+           (offset & 63);
+  }
+  return (p.x << bpb_log2) +
+         (((p.z * int(c.guest_z_stride_block_rows_aligned)) + p.y) * int(c.guest_pitch_aligned));
+}
+
+#if BPB_LOG2 != 0
+uvec4 Swap(uvec4 v) {
+  uint endian = (c.is_tiled_3d_endian_scale >> 2u) & 3u;
+#if BPB_LOG2 == 1
+  if (endian == 1u) {
+    v = ((v & 0x00FF00FFu) << 8u) | ((v & 0xFF00FF00u) >> 8u);
+  }
+#else
+  if (endian == 1u || endian == 2u) {
+    v = ((v & 0x00FF00FFu) << 8u) | ((v & 0xFF00FF00u) >> 8u);
+  }
+  if (endian == 2u || endian == 3u) {
+    v = (v << 16u) | (v >> 16u);
+  }
+#endif
+  return v;
+}
+
+uvec4 Convert(uvec4 v) {
+#if CONVERT == 1
+  // 24-bit float (4-bit exponent, 20-bit mantissa) in the upper 24 bits to a
+  // 32-bit float, as in texture_load_depth_float.
+  uvec4 f24 = v >> 8u;
+  uvec4 mantissa = f24 & 0xFFFFFu;
+  uvec4 exponent = f24 >> 20u;
+  bvec4 denormal = equal(exponent, uvec4(0u));
+  uvec4 msb = uvec4(findMSB(mantissa));
+  return mix(((mix(exponent, msb + uvec4(4294967277u), denormal) + uvec4(112u)) << 23u) |
+                 (mix(mantissa, (mantissa << (uvec4(20u) - msb)) & 0xFFFFFu, denormal) << 3u),
+             uvec4(0u), equal(f24, uvec4(0u)));
+#elif CONVERT == 2
+  return ((v & 0x83E083E0u) | ((v & 0x001F001Fu) << 10u)) | ((v & 0x7C007C00u) >> 10u);
+#else
+  return v;
+#endif
+}
+#endif
+
+void main() {
+  uvec3 block_index = gl_GlobalInvocationID << uvec3(X_BLOCKS_LOG2, 0u, 0u);
+  if (any(greaterThanEqual(block_index.xy, c.size_blocks.xy))) {
+    return;
+  }
+  ivec3 p = ivec3(block_index);
+  uint source_offset = uint(int(c.guest_offset) + GuestOffset(p));
+  bool tiled = (c.is_tiled_3d_endian_scale & 1u) != 0u;
+  // Raw texels in memory order (8 32-bit words).
+  uint words[8];
+#if BPB_LOG2 == 0
+  uint source_index = source_offset >> 3u;
+  uvec2 lo = source.data[source_index];
+  uvec2 hi = source.data[source_index + ((tiled ? 64u : 8u) >> 3u)];
+  words[0] = lo.x;
+  words[1] = lo.y;
+  words[2] = hi.x;
+  words[3] = hi.y;
+#else
+  uint source_index = source_offset >> 4u;
+#if BPB_LOG2 == 1
+  uint second = (tiled ? 64u : 16u) >> 4u;
+#else
+  uint second = (tiled ? 32u : 16u) >> 4u;
+#endif
+  uvec4 lo = Convert(Swap(source.data[source_index]));
+  uvec4 hi = Convert(Swap(source.data[source_index + second]));
+  words[0] = lo.x;
+  words[1] = lo.y;
+  words[2] = lo.z;
+  words[3] = lo.w;
+  words[4] = hi.x;
+  words[5] = hi.y;
+  words[6] = hi.z;
+  words[7] = hi.w;
+#endif
+  int width = int(c.size_blocks.x);
+  for (int i = 0; i < (1 << X_BLOCKS_LOG2); ++i) {
+    int x = p.x + i;
+    if (x >= width) {
+      break;
+    }
+#if BPB_LOG2 == 0
+    uvec4 texel = uvec4((words[i >> 2] >> (8u * uint(i & 3))) & 0xFFu, 0u, 0u, 0u);
+#elif BPB_LOG2 == 1
+    uvec4 texel = uvec4((words[i >> 1] >> (16u * uint(i & 1))) & 0xFFFFu, 0u, 0u, 0u);
+#elif BPB_LOG2 == 2
+    uvec4 texel = uvec4(words[i], 0u, 0u, 0u);
+#else
+    uvec4 texel = uvec4(words[i * 2], words[i * 2 + 1], 0u, 0u);
+#endif
+    imageStore(dest, ivec2(x, p.y), texel);
+  }
+}
