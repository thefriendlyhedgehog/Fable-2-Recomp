+  MarkBytesWrittenInSubmission(written_range.first, written_range.second);
+  if (draw && !REXCVAR_GET(vulkan_skip_disjoint_draw_barriers)) {
+    draw = nullptr;
+  }
+  uint32_t written_end = written_range.first + written_range.second;
+  if (draw) {
+    // Between draws (kRead and kGuestDrawReadWrite, no other write pending),
+    // only a conflict with the accesses since the last barrier needs one.
+    bool after_non_draw_write =
+        last_usage_ != Usage::kRead && last_usage_ != Usage::kGuestDrawReadWrite;
+    bool conflict = after_non_draw_write || last_written_range_.second != 0;
+    if (after_non_draw_write && REXCVAR_GET(vulkan_skip_draw_barriers_after_writes) &&
+        non_draw_pending_writes_known_ && draw->reads_known && !written_range.second) {
+      // After resolves and uploads: only a draw reading what they wrote needs
+      // the barrier (the draws since the last barrier only read, they wrote
+      // nothing).
+      conflict = false;
+      for (size_t i = 0; !conflict && i < draw->count; ++i) {
+        conflict = RangesOverlap(non_draw_pending_writes_, draw->ranges[i].first,
+                                 draw->ranges[i].first + draw->ranges[i].second);
+      }
+    }
+    if (!conflict && !draw_pending_writes_.empty()) {
