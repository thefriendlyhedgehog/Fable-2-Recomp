+// Long-frame attribution (vulkan_long_frame_log): command processor thread time
+// per area during the current frame. Time is charged to the innermost open
+// Scope only, so nested areas (a resolve inside a draw, a fence wait inside a
+// resolve) are never counted twice. Command processor thread only.
+// Namespace-scope rather than class members, so the classes keep the layout of
+// the SDK release.
+namespace frame_timing {
+enum Area : uint32_t {
+  kDraws,
+  kPipelines,
+  kTextures,
+  kSharedMemory,
+  kResolves,
+  kGpuWaits,
+  kFrameThrottle,
+  kSubmit,
+  kCompletedSubmissions,
+  kSwap,
+  kIdle,
+  kWaitRegMem,
+  kAreaCount,
+};
+// Whether Scopes measure; changed only between frames (EndFrame).
+extern bool enabled;
+extern uint64_t area_ns[kAreaCount];
+// kAreaCount when no Scope is open.
+extern uint32_t current_area;
+extern std::chrono::steady_clock::time_point mark;
+
+inline void Charge(std::chrono::steady_clock::time_point now) {
+  if (current_area < kAreaCount) {
+    area_ns[current_area] +=
+        uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(now - mark).count());
+  }
+  mark = now;
+}
+
+class Scope {
+ public:
+  explicit Scope(uint32_t area) : active_(enabled) {
+    if (active_) {
+      Charge(std::chrono::steady_clock::now());
+      previous_area_ = current_area;
+      current_area = area;
+    }
+  }
+  ~Scope() {
+    if (active_) {
+      Charge(std::chrono::steady_clock::now());
+      current_area = previous_area_;
+    }
+  }
+  Scope(const Scope&) = delete;
+  Scope& operator=(const Scope&) = delete;
+
+ private:
+  bool active_;
+  uint32_t previous_area_ = kAreaCount;
+};
+
+// Ends the frame at now: charges the time so far to it, moves its per-area
+// totals to frame_area_ns_out, and sets whether the next frame is measured.
+void EndFrame(std::chrono::steady_clock::time_point now, bool measure_next_frame,
+              uint64_t (&frame_area_ns_out)[kAreaCount]);
+}  // namespace frame_timing
