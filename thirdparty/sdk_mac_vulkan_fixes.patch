+  bool clip_disabled = regs.Get<reg::PA_CL_CLIP_CNTL>().clip_disable;
+  float xs[3], ys[3], zs[3];
+  float interpolators[3][xenos::kMaxInterpolators][4];
+  uint32_t written_interpolators = 0;
+  shader_interpreter_.SetShader(vertex_shader);
+  PositionExportSink position_export_sink;
+  shader_interpreter_.SetExportSink(&position_export_sink);
+  bool vertices_valid = true;
+  for (uint32_t i = 0; i < 3 && vertices_valid; ++i) {
+    position_export_sink = PositionExportSink();
+    shader_interpreter_.temp_registers()[0] = float(vertex_indices[i]);
+    shader_interpreter_.Execute();
+    const float* position = position_export_sink.position;
+    float w = position[3];
+    // X and Y divided by W unless vtx_xy_fmt (as in EstimateVertexMaxY), Z
+    // unless vtx_z_fmt.
+    float xy_w = pa_cl_vte_cntl.vtx_xy_fmt ? 1.0f : w;
+    float z = pa_cl_vte_cntl.vtx_z_fmt ? position[2] : position[2] / w;
+    // Not killed, all of the position written, and not clipped by depth. With
+    // clipping disabled, the host clamps the depth instead (the pipeline
+    // isn't created without depth clamping), so Z only needs to be a number
+    // then.
