+bool RenderTargetCache::PrepareClearQuadInPlace(
+    uint32_t rts, const RenderTargetKey* rt_keys, reg::RB_DEPTHCONTROL normalized_depth_control,
+    const Shader& vertex_shader, const Transfer::Rectangle& rectangle,
+    const DrawExtentEstimator::RectangleCoverageDetails& details) {
+  const RegisterFile& regs = register_file();
+  if (!details.exact || vertex_shader.memexport_eM_written()) {
+    return false;
+  }
+  RenderTarget* targets[1 + xenos::kMaxColorRenderTargets] = {};
+  uint64_t values[1 + xenos::kMaxColorRenderTargets] = {};
+  // The owners' rectangle, the same for all (one sample count).
+  Transfer::Rectangle owner_rectangle = {};
+  bool owner_rectangle_set = false;
+  uint32_t rts_remaining = rts;
+  uint32_t rt_index;
+  while (rex::bit_scan_forward(rts_remaining, &rt_index)) {
+    rts_remaining &= ~(uint32_t(1) << rt_index);
+    RenderTargetKey key = rt_keys[rt_index];
+    if (key.Is64bpp()) {
+      return false;
+    }
+    // The tile rows the rectangle is in, all owned by one render target.
+    uint32_t x_log2 = uint32_t(key.msaa_samples >= xenos::MsaaSamples::k4X);
+    uint32_t y_log2 = uint32_t(key.msaa_samples >= xenos::MsaaSamples::k2X);
+    uint32_t pitch_tiles = key.GetPitchTiles();
+    uint32_t x0_samples = rectangle.x_pixels << x_log2;
+    uint32_t y0_samples = rectangle.y_pixels << y_log2;
+    uint32_t x1_samples = (rectangle.x_pixels + rectangle.width_pixels) << x_log2;
+    uint32_t y1_samples = (rectangle.y_pixels + rectangle.height_pixels) << y_log2;
+    if (x1_samples > pitch_tiles * xenos::kEdramTileWidthSamples) {
+      return false;
+    }
+    uint32_t start_tiles =
+        key.base_tiles + y0_samples / xenos::kEdramTileHeightSamples * pitch_tiles;
+    uint32_t end_tiles =
+        key.base_tiles + (y1_samples + xenos::kEdramTileHeightSamples - 1) /
+                             xenos::kEdramTileHeightSamples * pitch_tiles;
+    if (end_tiles > xenos::kEdramTileCount) {
+      return false;
+    }
+    auto it = ownership_ranges_.upper_bound(start_tiles);
+    if (it == ownership_ranges_.begin()) {
+      return false;
+    }
+    --it;
+    RenderTargetKey owner = it->second.render_target;
+    bool host_depth_encoding_different = key.is_depth &&
+                                         GetPath() == Path::kHostRenderTargets &&
+                                         IsHostDepthEncodingDifferent(key.GetDepthFormat());
+    if (owner.IsEmpty() || owner.base_tiles != key.base_tiles ||
+        owner.pitch_tiles_at_32bpp != key.pitch_tiles_at_32bpp ||
+        owner.is_depth != key.is_depth || owner.resource_format != key.resource_format ||
+        owner.msaa_samples == key.msaa_samples) {
+      return false;
+    }
+    for (; it != ownership_ranges_.end() && it->first < end_tiles; ++it) {
+      if (!it->second.IsOwnedBy(owner, host_depth_encoding_different)) {
+        return false;
+      }
+    }
+    auto owner_it = render_targets_.find(owner);
+    if (owner_it == render_targets_.end() || !owner_it->second) {
+      return false;
+    }
+    // The rectangle in whole pixels of the owner.
+    uint32_t owner_x_log2 = uint32_t(owner.msaa_samples >= xenos::MsaaSamples::k4X);
+    uint32_t owner_y_log2 = uint32_t(owner.msaa_samples >= xenos::MsaaSamples::k2X);
+    if (((x0_samples | x1_samples) & ((uint32_t(1) << owner_x_log2) - 1)) ||
+        ((y0_samples | y1_samples) & ((uint32_t(1) << owner_y_log2) - 1))) {
+      return false;
+    }
+    Transfer::Rectangle rt_owner_rectangle;
+    rt_owner_rectangle.x_pixels = x0_samples >> owner_x_log2;
+    rt_owner_rectangle.y_pixels = y0_samples >> owner_y_log2;
+    rt_owner_rectangle.width_pixels = (x1_samples - x0_samples) >> owner_x_log2;
+    rt_owner_rectangle.height_pixels = (y1_samples - y0_samples) >> owner_y_log2;
+    if (owner_rectangle_set &&
+        (rt_owner_rectangle.x_pixels != owner_rectangle.x_pixels ||
+         rt_owner_rectangle.y_pixels != owner_rectangle.y_pixels ||
+         rt_owner_rectangle.width_pixels != owner_rectangle.width_pixels ||
+         rt_owner_rectangle.height_pixels != owner_rectangle.height_pixels)) {
+      return false;
+    }
+    owner_rectangle = rt_owner_rectangle;
+    owner_rectangle_set = true;
+    targets[rt_index] = owner_it->second;
+
+    // The value, as the guest stores it, and only if the host would store
+    // exactly the same when drawing.
+    if (key.is_depth) {
+      auto pa_su_sc_mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+      if (!details.z_uniform || !(details.z >= 0.0f && details.z <= 1.0f) ||
+          pa_su_sc_mode_cntl.poly_offset_front_enable ||
+          pa_su_sc_mode_cntl.poly_offset_back_enable) {
+        return false;
+      }
+      uint32_t depth;
+      switch (key.GetDepthFormat()) {
+        case xenos::DepthRenderTargetFormat::kD24S8:
+          depth = uint32_t(std::lround(details.z * float(0xFFFFFF)));
+          if (xenos::UNorm24To32(depth) != details.z) {
+            return false;
+          }
+          break;
+        case xenos::DepthRenderTargetFormat::kD24FS8:
+          depth = xenos::Float32To20e4(details.z, true);
+          if (xenos::Float20e4To32(depth) != details.z) {
+            return false;
+          }
+          break;
+        default:
+          return false;
+      }
+      auto rb_stencilrefmask = regs.Get<reg::RB_STENCILREFMASK>();
+      uint32_t stencil = rb_stencilrefmask.stencilref;
+      if (normalized_depth_control.backface_enable &&
+          reg::RB_STENCILREFMASK{regs[XE_GPU_REG_RB_STENCILREFMASK_BF]}.stencilref != stencil) {
+        return false;
+      }
+      values[0] = (uint64_t(depth) << 8) | stencil;
+    } else {
+      uint32_t color_index = rt_index - 1;
+      const Shader* pixel_shader = update_pixel_shader_;
+      if (!pixel_shader) {
+        return false;
+      }
+      auto color_info = regs.Get<reg::RB_COLOR_INFO>(
+          reg::RB_COLOR_INFO::rt_register_indices[color_index]);
+      if (color_info.color_exp_bias) {
+        return false;
+      }
+      uint32_t param_gen_pos;
+      uint32_t interpolator_mask = pixel_shader->GetInterpolatorInputMask(
+          regs.Get<reg::SQ_PROGRAM_CNTL>(), regs.Get<reg::SQ_CONTEXT_MISC>(), param_gen_pos);
+      float color[4];
+      if (param_gen_pos != UINT32_MAX ||
+          !draw_extent_estimator_.EvaluateUniformPixelShaderColor(
+              *pixel_shader, interpolator_mask, details, color_index, color)) {
+        return false;
+      }
+      // Normalized values the host rounds unambiguously (not close to half).
+      auto pack_unorm = [](float value, uint32_t max, uint32_t& packed) {
+        float scaled = std::min(std::max(value, 0.0f), 1.0f) * float(max);
+        float fraction = scaled - std::floor(scaled);
+        if (std::abs(fraction - 0.5f) < 0.01f) {
+          return false;
+        }
+        packed = uint32_t(std::lround(scaled));
+        return true;
+      };
+      // The guest format, not the resource one (which may be the same for
+      // gamma, converted in the shader).
+      uint32_t packed = 0;
+      switch (color_info.color_format) {
+        case xenos::ColorRenderTargetFormat::k_8_8_8_8:
+          for (uint32_t i = 0; i < 4; ++i) {
+            uint32_t component;
+            if (!pack_unorm(color[i], 0xFF, component)) {
+              return false;
+            }
+            packed |= component << (8 * i);
+          }
+          break;
+        case xenos::ColorRenderTargetFormat::k_2_10_10_10:
+          for (uint32_t i = 0; i < 4; ++i) {
+            uint32_t component;
+            if (!pack_unorm(color[i], i < 3 ? 0x3FF : 0x3, component)) {
+              return false;
+            }
+            packed |= component << (10 * i);
+          }
+          break;
+        default:
+          return false;
+      }
+      values[rt_index] = packed;
+    }
+  }
+  std::memcpy(last_update_in_place_clear_targets_, targets, sizeof(targets));
+  std::memcpy(last_update_in_place_clear_values_, values, sizeof(values));
+  last_update_in_place_clear_rectangle_ = owner_rectangle;
+  return true;
+}
