+// vulkan_debug_dump_resolves: whether the resolve to dest_base is listed.
+bool IsResolveDumpRequested(uint32_t dest_base) {
+  const std::string& list = REXCVAR_GET(vulkan_debug_dump_resolves);
+  size_t pos = 0;
+  while (pos < list.size()) {
+    size_t end = list.find(',', pos);
+    if (end == std::string::npos) {
+      end = list.size();
+    }
+    std::string entry = list.substr(pos, end - pos);
+    pos = end + 1;
+    size_t first = entry.find_first_not_of(" \t");
+    if (first == std::string::npos) {
+      continue;
+    }
+    entry = entry.substr(first, entry.find_last_not_of(" \t") - first + 1);
+    char* parse_end = nullptr;
+    unsigned long long address = std::strtoull(entry.c_str(), &parse_end, 16);
+    if (parse_end && *parse_end == '\0' && address == dest_base) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// vulkan_debug_dump_resolves: a resolve's written range copied out of the
+// shared memory into a host-visible buffer in the command stream, written to
+// a file once its submission has completed (no queue drain, guest memory
+// untouched). Command processor thread only.
+struct PendingResolveDump {
+  uint64_t submission;
+  VkBuffer buffer;
+  VkDeviceMemory memory;
+  void* mapping;
+  uint32_t written_address;
+  uint32_t written_length;
+  uint32_t dest_base;
+  uint32_t width;
+  uint32_t height;
+  uint32_t format;
+  uint32_t endian;
+  uint32_t resolve_index;
+};
+std::vector<PendingResolveDump> pending_resolve_dumps;
+uint32_t resolve_dump_count = 0;
+// vulkan_debug_dump_frames: frames left to dump after the current one,
+// whether the current frame is dumped, and the resolves in it so far.
+int32_t dump_frames_remaining = 0;
+bool dump_frame_active = false;
+uint32_t dump_frame_resolves = 0;
+
+// Untiles the destination (pitch x height from the copy registers) out of the
+// written range; texels outside it are written as zero.
+void WriteResolveDump(const PendingResolveDump& dump) {
+  const FormatInfo* format_info = FormatInfo::Get(dump.format);
+  uint32_t bits_per_pixel = format_info ? format_info->bits_per_pixel : 0;
+  uint32_t bytes_per_pixel_log2;
+  if (!dump.width || !dump.height ||
+      (bits_per_pixel != 8 && bits_per_pixel != 16 && bits_per_pixel != 32 &&
+       bits_per_pixel != 64) ||
+      !rex::bit_scan_forward(bits_per_pixel >> 3, &bytes_per_pixel_log2)) {
+    REXGPU_WARN("[frame] resolve {} to 0x{:08X} not dumped: format {} ({} bpp), {}x{}",
+                dump.resolve_index, dump.dest_base, dump.format, bits_per_pixel, dump.width,
+                dump.height);
+    return;
+  }
+  uint32_t bytes_per_pixel = bits_per_pixel >> 3;
+  const uint8_t* source = static_cast<const uint8_t*>(dump.mapping);
+  std::vector<uint8_t> pixels(size_t(dump.width) * dump.height * bytes_per_pixel, 0);
+  for (uint32_t y = 0; y < dump.height; ++y) {
+    for (uint32_t x = 0; x < dump.width; ++x) {
+      int64_t address = int64_t(dump.dest_base) +
+                        texture_util::GetTiledOffset2D(int32_t(x), int32_t(y), dump.width,
+                                                       bytes_per_pixel_log2) -
+                        int64_t(dump.written_address);
+      if (address < 0 || address + bytes_per_pixel > int64_t(dump.written_length)) {
+        continue;
+      }
+      std::memcpy(&pixels[(size_t(y) * dump.width + x) * bytes_per_pixel], source + address,
+                  bytes_per_pixel);
+    }
+  }
+  std::string path = fmt::format(
+      "{}/resolve_{:03}_r{}_{:08X}_f{}_e{}_{}x{}_{}bpp.bin", REXCVAR_GET(vulkan_debug_dump_dir),
+      resolve_dump_count++, dump.resolve_index, dump.dest_base, dump.format, dump.endian,
+      dump.width, dump.height, bits_per_pixel);
+  FILE* file = std::fopen(path.c_str(), "wb");
+  if (!file) {
+    REXGPU_WARN("[frame] resolve {}: could not write {}", dump.resolve_index, path);
+    return;
+  }
+  std::fwrite(pixels.data(), 1, pixels.size(), file);
+  std::fclose(file);
+  REXGPU_INFO("[frame] resolve {} dumped to {}", dump.resolve_index, path);
+}
+
+// Writes the dumps whose submissions have completed (all of them with
+// destroy_all, after the queue has been drained) and frees their buffers.
+void ProcessPendingResolveDumps(const ui::vulkan::VulkanDevice* vulkan_device,
+                                uint64_t completed_submission, bool destroy_all) {
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  for (auto it = pending_resolve_dumps.begin(); it != pending_resolve_dumps.end();) {
+    if (!destroy_all && it->submission > completed_submission) {
+      ++it;
+      continue;
+    }
+    if (it->submission <= completed_submission) {
+      VkMappedMemoryRange range = {};
+      range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+      range.memory = it->memory;
+      range.offset = 0;
+      range.size = VK_WHOLE_SIZE;
+      dfn.vkInvalidateMappedMemoryRanges(device, 1, &range);
+      WriteResolveDump(*it);
+    }
+    dfn.vkUnmapMemory(device, it->memory);
+    dfn.vkDestroyBuffer(device, it->buffer, nullptr);
+    dfn.vkFreeMemory(device, it->memory, nullptr);
+    it = pending_resolve_dumps.erase(it);
+  }
+}
