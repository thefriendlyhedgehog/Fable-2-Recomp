+VkRenderPass VulkanCommandProcessor::NotePassLogBegin(std::string target,
+                                                      VkRenderPass render_pass) {
+  // A render pass inside a timed span (some resolves draw) ends the span:
+  // nested, the span's end timestamp would not be written.
+  EndTimedSpan();
+  if (!REXCVAR_GET(vulkan_pass_log) && !gpu_pass_time_frame_) {
+    return render_pass;
