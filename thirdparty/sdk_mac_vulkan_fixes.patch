+void DrawExtentEstimator::PositionExportSink::Export(ucode::ExportRegister export_register,
+                                                     const float* value, uint32_t value_mask) {
+  if (export_register == ucode::ExportRegister::kVSPosition) {
+    for (uint32_t i = 0; i < 4; ++i) {
+      if (value_mask & (uint32_t(1) << i)) {
+        position[i] = value[i];
+      }
+    }
+    position_mask |= value_mask & 0b1111;
+  } else if (export_register == ucode::ExportRegister::kVSPointSizeEdgeFlagKillVertex) {
+    if (value_mask & 0b0100) {
+      vertex_kill = rex::memory::Reinterpret<uint32_t>(value[2]);
+    }
+  } else if (uint32_t(export_register) < xenos::kMaxInterpolators) {
+    uint32_t interpolator = uint32_t(export_register);
+    for (uint32_t i = 0; i < 4; ++i) {
+      if (value_mask & (uint32_t(1) << i)) {
+        interpolators[interpolator][i] = value[i];
+      }
+    }
+    interpolator_masks[interpolator] |= value_mask & 0b1111;
+  }
+}
+
+void DrawExtentEstimator::ColorExportSink::Export(ucode::ExportRegister export_register,
+                                                  const float* value, uint32_t value_mask) {
+  uint32_t color_index = uint32_t(export_register) - uint32_t(ucode::ExportRegister::kPSColor0);
+  if (color_index < xenos::kMaxColorRenderTargets) {
+    for (uint32_t i = 0; i < 4; ++i) {
+      if (value_mask & (uint32_t(1) << i)) {
+        colors[color_index][i] = value[i];
+      }
+    }
+    color_masks[color_index] |= value_mask & 0b1111;
+  } else {
+    other_export = true;
+  }
+}
+
+bool DrawExtentEstimator::EvaluateUniformPixelShaderColor(const Shader& pixel_shader,
+                                                          uint32_t interpolator_mask,
+                                                          const RectangleCoverageDetails& details,
+                                                          uint32_t rt_index, float color_out[4]) {
+  assert_true(pixel_shader.is_ucode_analyzed());
+  if (rt_index >= xenos::kMaxColorRenderTargets || !ShaderInterpreter::CanInterpretShader(pixel_shader) ||
+      pixel_shader.writes_depth() || pixel_shader.kills_pixels() ||
+      pixel_shader.memexport_eM_written() || pixel_shader.uses_register_dynamic_addressing() ||
+      (interpolator_mask & details.written_interpolators & ~details.uniform_interpolators)) {
+    return false;
+  }
+  shader_interpreter_.SetShader(pixel_shader);
+  // Interpolators in the first registers (those the vertex shader doesn't
+  // write are zero, as on the host), the rest zero.
+  float* temps = shader_interpreter_.temp_registers();
+  std::memset(temps, 0, sizeof(float) * 4 * xenos::kMaxShaderTempRegisters);
+  for (uint32_t i = 0; i < xenos::kMaxInterpolators; ++i) {
+    if ((interpolator_mask & details.written_interpolators) & (uint32_t(1) << i)) {
+      std::memcpy(temps + 4 * i, details.interpolators[i], sizeof(float) * 4);
+    }
+  }
+  ColorExportSink color_export_sink;
+  shader_interpreter_.SetExportSink(&color_export_sink);
+  shader_interpreter_.Execute();
+  shader_interpreter_.SetExportSink(nullptr);
+  if (color_export_sink.other_export || color_export_sink.color_masks[rt_index] != 0b1111) {
+    return false;
+  }
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (!std::isfinite(color_export_sink.colors[rt_index][i])) {
+      return false;
+    }
+    color_out[i] = color_export_sink.colors[rt_index][i];
+  }
+  return true;
+}
+
+bool DrawExtentEstimator::EstimateRectangleCoverage(const Shader& vertex_shader,
