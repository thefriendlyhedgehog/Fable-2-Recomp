+  length = std::min(length, kBufferSize - start);
+  uint32_t page_size_log2_value = page_size_log2();
+  uint32_t page_first = start >> page_size_log2_value;
+  uint32_t page_last = (start + length - 1) >> page_size_log2_value;
+  uint64_t completed = race_completed_submission_.load(std::memory_order_relaxed);
+  std::lock_guard<std::mutex> lock(race_mutex_);
+  ++race_cpu_writes_;
+  for (uint32_t page = page_first; page <= page_last; ++page) {
+    uint64_t submission = race_page_submission_[page].load(std::memory_order_acquire);
+    if (submission <= completed) {
+      continue;
+    }
+    if (race_snapshot_free_slots_.empty()) {
+      ++race_snapshots_dropped_;
+      continue;
+    }
+    RaceSnapshot snapshot;
+    snapshot.page = page;
+    snapshot.submission = submission;
+    snapshot.span = race_page_span_[page].load(std::memory_order_relaxed);
+    snapshot.request = race_page_request_[page].load(std::memory_order_relaxed);
+    snapshot.slot = race_snapshot_free_slots_.back();
+    race_snapshot_free_slots_.pop_back();
+    CaptureFaultingWriter(snapshot.writer);
+    snapshot.newer =
+        uint32_t(race_latest_submission_.load(std::memory_order_relaxed) - submission);
