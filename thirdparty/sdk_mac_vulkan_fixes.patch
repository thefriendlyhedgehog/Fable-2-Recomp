--- /dev/null
+++ b/src/graphics/shaders/resolve_direct_fast_32bpp.cs.glsl
@@ -0,0 +1,188 @@
+// Direct resolve (direct_host_resolve, host render target path): the
+// resolve_fast_32bpp_1x2xmsaa copy reading the texels from the host render
+// target instead of the EDRAM buffer, so the render target is not dumped into
+// the EDRAM buffer first. Only for 1x render targets owning the whole
+// resolved region; the texels are packed into the EDRAM representation the
+// same way as by the dump shaders (VulkanRenderTargetCache::GetDumpPipeline).
+//
+// Built by tools/build_texture_load_image_shaders.sh with SOURCE_UINT 0 (float
+// view: k_8_8_8_8, k_2_10_10_10, k_32_FLOAT without a uint transfer view), 1
+// (uint view: k_32_FLOAT), or DEPTH 1 (depth and stencil views).
+//
+// Depth: the dump stores each depth sample with the 40-sample halves of the
+// tile swapped and the resolve swaps them back when reading, so the render
+// target is read at the unswapped position.
+#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+
+#ifndef SOURCE_UINT
+#define SOURCE_UINT 0
+#endif
+#ifndef DEPTH
+#define DEPTH 0
+#endif
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+
+// VulkanRenderTargetCache::DirectResolvePushConstants.
+layout(push_constant) uniform Constants {
+  uint edram_info;
+  uint coordinate_info;
+  uint dest_info;
+  uint dest_coordinate_info;
+  uint dest_base;
+  uint source_base_tiles;
+  // Bits 0:9 - pitch in tiles, 16:18 - packing (0 - 8_8_8_8, 1 - 2_10_10_10,
+  // 2 - raw 32 bits, 3 - D24S8, 4 - D24FS8 rounding to the nearest even,
+  // 5 - D24FS8 truncating).
+  uint source_pitch_tiles;
+  uint dispatch_first_tile;
+} c;
+
+layout(set = 0, binding = 0, std430) writeonly buffer Dest { uvec4 data[]; } dest;
+#if DEPTH
+layout(set = 1, binding = 0) uniform texture2D source;
+layout(set = 1, binding = 1) uniform utexture2D source_stencil;
+#elif SOURCE_UINT
+layout(set = 1, binding = 0) uniform utexture2D source;
+#else
+layout(set = 1, binding = 0) uniform texture2D source;
+#endif
+
+#if DEPTH
+// SpirvShaderTranslator::PreClampedDepthTo20e4 with remap_from_0_to_0_5.
+uint DepthTo20e4(float depth, bool round_to_nearest_even) {
+  uint f32 = floatBitsToUint(depth);
+  uint denormal = ((f32 & 0x7FFFFFu) | 0x800000u) >> min(112u - (f32 >> 23u), 24u);
+  uint normal = f32 - (111u << 23u);
+  uint biased = f32 < (0x38800000u - (1u << 23u)) ? denormal : normal;
+  if (round_to_nearest_even) {
+    biased += 3u + ((biased >> 3u) & 1u);
+  }
+  return (biased >> 3u) & 0xFFFFFFu;
+}
+#endif
+
+uint Pack(ivec2 p) {
+#if DEPTH
+  float depth = texelFetch(source, p, 0).r;
+  uint packing = (c.source_pitch_tiles >> 16u) & 7u;
+  uint depth24 = packing == 3u ? uint(roundEven(depth * 16777215.0))
+                               : DepthTo20e4(depth, packing == 4u);
+  return (depth24 << 8u) | (texelFetch(source_stencil, p, 0).r & 0xFFu);
+#elif SOURCE_UINT
+  return texelFetch(source, p, 0).r;
+#else
+  vec4 v = texelFetch(source, p, 0);
+  uint packing = (c.source_pitch_tiles >> 16u) & 7u;
+  if (packing == 0u) {
+    uvec4 u = uvec4(v * 255.0 + 0.5);
+    return u.r | (u.g << 8u) | (u.b << 16u) | (u.a << 24u);
+  }
+  if (packing == 1u) {
+    uvec4 u = uvec4(v * vec4(1023.0, 1023.0, 1023.0, 3.0) + 0.5);
+    return u.r | (u.g << 10u) | (u.b << 20u) | (u.a << 30u);
+  }
+  return floatBitsToUint(v.r);
+#endif
+}
+
+uvec4 SwapRB(uvec4 v) {
