+  static constexpr uint32_t kFsiRenderPassCount = 3;
+  VkRenderPass fsi_render_passes_[kFsiRenderPassCount] = {};
   Framebuffer fsi_framebuffer_;
 
   VkPipelineLayout resolve_fsi_clear_pipeline_layout_ = VK_NULL_HANDLE;
