   // A render pass managed by the render target cache may be ended and resumed
   // at any time (to allow for things like copying and texture loading).
   VkRenderPass GetHostRenderTargetsRenderPass(RenderPassKey key);
-  VkRenderPass GetFragmentShaderInterlockRenderPass() const {
+  // Host sample count (log2) that fragment shader interlock pipelines and
+  // draws use for the given guest MSAA mode (2x is promoted to 4x on devices
+  // without 2x).
+  uint32_t GetFsiHostSampleCountLog2(xenos::MsaaSamples msaa_samples) const {
+    if (msaa_samples == xenos::MsaaSamples::k2X && !IsMsaa2xSupported(false)) {
+      return 2;
+    }
+    return uint32_t(msaa_samples);
+  }
+  // One attachment-less render pass per host sample count. MoltenVK learns
+  // the sample count of an attachment-less pass from the pipelines created
+  // against it (Metal needs it explicitly, as defaultRasterSampleCount), and
+  // keeps one value per pass, so pipelines of different sample counts must
+  // not share a pass, and dynamic rendering (no pass object) cannot carry it
+  // at all.
+  VkRenderPass GetFragmentShaderInterlockRenderPass(uint32_t host_sample_count_log2) const {
     assert_true(GetPath() == Path::kPixelShaderInterlock);
-    return fsi_render_pass_;
+    assert_true(host_sample_count_log2 < kFsiRenderPassCount);
+    return fsi_render_passes_[host_sample_count_log2];
   }
 
   VkFormat GetDepthVulkanFormat(xenos::DepthRenderTargetFormat format) const;
@@ -873,7 +889,9 @@ class VulkanRenderTargetCache final : public RenderTargetCache {
 
