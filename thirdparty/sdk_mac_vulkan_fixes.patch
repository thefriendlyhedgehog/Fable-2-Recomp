+bool CommandProcessor::ShouldForceReadbackResolve(uint32_t dest_base) const {
+  const std::string& list = REXCVAR_GET(readback_resolve_force_addresses);
+  if (list.empty()) {
+    return false;
+  }
+  size_t pos = 0;
+  while (pos < list.size()) {
+    size_t end = list.find(',', pos);
+    if (end == std::string::npos) {
+      end = list.size();
+    }
+    std::string_view entry(list.data() + pos, end - pos);
+    while (!entry.empty() && (entry.front() == ' ' || entry.front() == '\t')) {
+      entry.remove_prefix(1);
+    }
+    while (!entry.empty() && (entry.back() == ' ' || entry.back() == '\t')) {
+      entry.remove_suffix(1);
+    }
+    if (!entry.empty()) {
+      int base = 10;
+      if (entry.size() > 2 && entry[0] == '0' && (entry[1] == 'x' || entry[1] == 'X')) {
+        entry.remove_prefix(2);
+        base = 16;
+      }
+      uint64_t address = 0;
+      bool valid = !entry.empty();
+      for (char c : entry) {
+        uint32_t digit;
+        if (c >= '0' && c <= '9') {
+          digit = uint32_t(c - '0');
+        } else if (base == 16 && c >= 'a' && c <= 'f') {
+          digit = uint32_t(c - 'a' + 10);
+        } else if (base == 16 && c >= 'A' && c <= 'F') {
+          digit = uint32_t(c - 'A' + 10);
+        } else {
+          valid = false;
+          break;
+        }
+        address = address * uint64_t(base) + digit;
+        if (address > UINT32_MAX) {
+          valid = false;
+          break;
+        }
+      }
+      // 64 KiB: the hero/dog target 0x12704000 has other resolve targets
+      // 128 KiB away (0x12724000, ...); a wider window reads those back too.
+      if (valid && dest_base >= address && uint64_t(dest_base) < address + (uint64_t(1) << 16)) {
+        return true;
+      }
+    }
+    pos = end + 1;
+  }
+  return false;
+}
