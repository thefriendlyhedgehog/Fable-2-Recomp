+  if (pages_used_submission_ == submission) {
+    return;
+  }
+  pages_used_submission_ = submission;
+  size_t word_count = ((kBufferSize >> page_size_log2()) + 63) / 64;
+  if (pages_used_in_submission_.size() != word_count) {
+    pages_used_in_submission_.assign(word_count, 0);
+  } else {
+    std::fill(pages_used_in_submission_.begin(), pages_used_in_submission_.end(), 0);
+  }
+}
+
+void VulkanSharedMemory::MarkPagesUsedInSubmission(uint32_t page_first, uint32_t page_count) {
+  UpdatePagesUsedSubmission();
+  uint32_t page_end = std::min(page_first + page_count, kBufferSize >> page_size_log2());
+  for (uint32_t page = page_first; page < page_end;) {
+    uint32_t bit = page & 63;
+    uint32_t count = std::min(64 - bit, page_end - page);
+    uint64_t mask = count == 64 ? ~uint64_t(0) : ((uint64_t(1) << count) - 1) << bit;
+    pages_used_in_submission_[page >> 6] |= mask;
+    page += count;
+  }
+}
+
+void VulkanSharedMemory::MarkBytesUsedInSubmission(uint32_t start, uint32_t length) {
+  if (!length) {
+    return;
+  }
+  uint32_t page_first = start >> page_size_log2();
+  uint32_t page_last = uint32_t((uint64_t(start) + length - 1) >> page_size_log2());
+  MarkPagesUsedInSubmission(page_first, page_last - page_first + 1);
+}
+
+bool VulkanSharedMemory::ArePagesUsedInSubmission(uint32_t page_first, uint32_t page_count) {
+  UpdatePagesUsedSubmission();
+  uint32_t page_end = std::min(page_first + page_count, kBufferSize >> page_size_log2());
+  for (uint32_t page = page_first; page < page_end;) {
+    uint32_t bit = page & 63;
+    uint32_t count = std::min(64 - bit, page_end - page);
+    uint64_t mask = count == 64 ? ~uint64_t(0) : ((uint64_t(1) << count) - 1) << bit;
+    if (pages_used_in_submission_[page >> 6] & mask) {
+      return true;
+    }
+    page += count;
+  }
+  return false;
+}
