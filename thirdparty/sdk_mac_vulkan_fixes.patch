+
+void VulkanTextureCache::CompletedSubmissionUpdated(uint64_t completed_submission_index) {
+  // Destroy the retired textures the GPU is done with.
+  for (size_t i = 0; i < retired_textures_.size();) {
+    if (retired_textures_[i]->last_usage_submission_index() <= completed_submission_index) {
+      retired_textures_[i] = std::move(retired_textures_.back());
+      retired_textures_.pop_back();
+    } else {
+      ++i;
+    }
+  }
+  TextureCache::CompletedSubmissionUpdated(completed_submission_index);
+}
