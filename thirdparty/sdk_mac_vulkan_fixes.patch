+    return false;
+  }
+  float min_x = std::min(xs[0], std::min(xs[1], xs[2]));
+  float max_x = std::max(xs[0], std::max(xs[1], xs[2]));
+  float min_y = std::min(ys[0], std::min(ys[1], ys[2]));
+  float max_y = std::max(ys[0], std::max(ys[1], ys[2]));
