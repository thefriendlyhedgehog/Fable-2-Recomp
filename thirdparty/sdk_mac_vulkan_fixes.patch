+std::string DescribeCode(uint64_t address) {
+#if REX_PLATFORM_WIN32
+  return fmt::format("0x{:X}", address);
+#else
+  Dl_info info;
+  if (!address || !dladdr(reinterpret_cast<const void*>(address), &info)) {
+    return fmt::format("0x{:X}", address);
+  }
+  if (info.dli_sname) {
+    return fmt::format("{}+0x{:X}", info.dli_sname,
+                       address - reinterpret_cast<uint64_t>(info.dli_saddr));
+  }
+  const char* image = info.dli_fname ? std::strrchr(info.dli_fname, '/') : nullptr;
+  return fmt::format("{}+0x{:X}", image ? image + 1 : "?",
+                     address - reinterpret_cast<uint64_t>(info.dli_fbase));
+#endif
