+// vulkan_present_pacing_log: on-screen frame durations, in display refreshes.
+void LogPresentPacing(const VulkanDevice* device, VkSwapchainKHR swapchain) {
+  static const auto get_past = PFN_vkGetPastPresentationTimingGOOGLE(
+      device->vulkan_instance()->functions().vkGetDeviceProcAddr(
+          device->device(), "vkGetPastPresentationTimingGOOGLE"));
+  static const auto get_refresh = PFN_vkGetRefreshCycleDurationGOOGLE(
+      device->vulkan_instance()->functions().vkGetDeviceProcAddr(
+          device->device(), "vkGetRefreshCycleDurationGOOGLE"));
+  if (!get_past || !get_refresh) {
+    return;
+  }
+  static uint64_t last_time = 0, sum_ns = 0, frames = 0;
+  static uint64_t histogram[8] = {};
+  static auto next_log = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+  static uint64_t refresh_ns = 0;
+  VkRefreshCycleDurationGOOGLE refresh = {};
+  if (!refresh_ns && get_refresh(device->device(), swapchain, &refresh) == VK_SUCCESS) {
+    refresh_ns = refresh.refreshDuration;
+  }
+  VkPastPresentationTimingGOOGLE timings[64];
+  uint32_t count = uint32_t(std::size(timings));
+  get_past(device->device(), swapchain, &count, timings);
+  static uint64_t presents = 0, last_any_time = 0;
+  // Intervals between consecutive presents of any kind, in 0.25 ms bins: the
+  // most common one is the compositor's real refresh (repaints run at it).
+  static uint32_t interval_bins[200] = {};
+  for (uint32_t i = 0; i < count; ++i) {
+    ++presents;
+    uint64_t any_time = timings[i].actualPresentTime;
+    if (last_any_time && any_time > last_any_time) {
+      uint64_t bin = (any_time - last_any_time) / 250000;
+      if (bin < std::size(interval_bins)) {
+        ++interval_bins[bin];
+      }
+    }
+    last_any_time = any_time;
+    if (!timings[i].presentID) {
+      continue;  // A repaint of the same guest frame.
+    }
+    uint64_t t = timings[i].actualPresentTime;
+    if (last_time && t > last_time && refresh_ns) {
+      uint64_t d = t - last_time;
+      uint64_t refreshes = (d + refresh_ns / 2) / refresh_ns;
+      ++histogram[std::min<uint64_t>(refreshes, 7)];
+      sum_ns += d;
+      ++frames;
+    }
+    last_time = t;
+  }
+  auto now = std::chrono::steady_clock::now();
+  if (now < next_log) {
+    return;
+  }
+  next_log = now + std::chrono::seconds(REXCVAR_GET(vulkan_present_pacing_log));
+  uint32_t mode_bin = 0;
+  for (uint32_t i = 1; i < std::size(interval_bins); ++i) {
+    if (interval_bins[i] > interval_bins[mode_bin]) {
+      mode_bin = i;
+    }
+  }
+  // Mean of the most common bin and its neighbours.
+  double weight = 0.0, weighted = 0.0;
+  for (uint32_t i = mode_bin ? mode_bin - 1 : 0; i <= mode_bin + 1 && i < std::size(interval_bins);
+       ++i) {
+    weight += interval_bins[i];
+    weighted += interval_bins[i] * (i + 0.5) * 0.25;
+  }
+  if (weight > 0.0) {
+    REXLOG_INFO("Present pacing: presents most often {:.2f} ms apart ({:.1f} Hz)",
+                weighted / weight, 1000.0 * weight / weighted);
+  }
+  std::fill(std::begin(interval_bins), std::end(interval_bins), 0);
+  if (frames) {
+    REXLOG_INFO(
+        "Present pacing over {} guest frames ({} presents; display refresh {:.2f} ms): on screen "
+        "for 1/2/3/4/5/6/7+ refreshes: {}/{}/{}/{}/{}/{}/{} (under half a refresh: {}); mean "
+        "frame time {:.2f} ms",
+        frames, presents, refresh_ns * 1e-6, histogram[1], histogram[2], histogram[3],
+        histogram[4], histogram[5], histogram[6], histogram[7], histogram[0],
+        sum_ns * 1e-6 / frames);
+  }
+  frames = 0;
+  presents = 0;
+  sum_ns = 0;
+  std::fill(std::begin(histogram), std::end(histogram), 0);
+  refresh_ns = 0;  // The window may be on another display by the next log.
+}
