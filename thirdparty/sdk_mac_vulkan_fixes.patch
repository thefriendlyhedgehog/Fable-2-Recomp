+  std::string path = fmt::format(
+      "{}/resolve_{:03}_r{}_{:08X}_f{}_e{}_{}x{}_{}bpp.bin", REXCVAR_GET(vulkan_debug_dump_dir),
+      resolve_dump_count++, dump.resolve_index, dump.dest_base, dump.format, dump.endian,
+      dump.width, dump.height, bits_per_pixel);
+  FILE* file = std::fopen(path.c_str(), "wb");
+  if (!file) {
+    REXGPU_WARN("[frame] resolve {}: could not write {}", dump.resolve_index, path);
+    return;
+  }
+  std::fwrite(pixels.data(), 1, pixels.size(), file);
+  std::fclose(file);
+  REXGPU_INFO("[frame] resolve {} dumped to {}", dump.resolve_index, path);
