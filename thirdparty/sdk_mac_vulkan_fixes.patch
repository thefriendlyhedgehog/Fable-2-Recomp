+  // GPU writes come here too; they make the page GPU-written in the
+  // submission, which keeps later uploads of it in the command stream anyway.
+  if (page_read_spans_.empty() || start >= kBufferSize) {
+    return;
+  }
+  length = std::min(length, kBufferSize - start);
+  uint32_t page_size_log2_value = page_size_log2();
+  uint32_t page_size = uint32_t(1) << page_size_log2_value;
+  uint32_t last = start + (length - 1);
+  uint32_t page_first = start >> page_size_log2_value;
+  uint32_t page_last = last >> page_size_log2_value;
+  uint64_t submission = pages_used_submission_;
+  auto mark_span = [&](uint32_t page, uint32_t begin, uint32_t end) {
+    PageReadSpan& span = page_read_spans_[page];
+    if (span.submission != submission) {
+      span.submission = submission;
+      span.begin = begin;
+      span.end = end;
+    } else {
+      span.begin = std::min(span.begin, begin);
+      span.end = std::max(span.end, end);
+    }
+  };
+  uint32_t first_begin = start & (page_size - 1);
+  uint32_t last_end = (last & (page_size - 1)) + 1;
+  if (page_first == page_last) {
+    mark_span(page_first, first_begin, last_end);
+    return;
+  }
+  mark_span(page_first, first_begin, page_size);
+  mark_span(page_last, 0, last_end);
+  for (uint32_t page = page_first + 1; page < page_last;) {
+    uint32_t bit = page & 63;
+    uint32_t count = std::min(64 - bit, page_last - page);
+    uint64_t mask = count == 64 ? ~uint64_t(0) : ((uint64_t(1) << count) - 1) << bit;
+    pages_read_whole_in_submission_[page >> 6] |= mask;
+    page += count;
+  }
+}
+
+bool VulkanSharedMemory::GetPageReadSpan(uint32_t page, uint32_t& begin, uint32_t& end) const {
+  if (pages_read_whole_in_submission_[page >> 6] & (uint64_t(1) << (page & 63))) {
+    begin = 0;
+    end = uint32_t(1) << page_size_log2();
+    return true;
+  }
+  const PageReadSpan& span = page_read_spans_[page];
+  if (span.submission != pages_used_submission_) {
+    return false;
+  }
+  begin = span.begin;
+  end = span.end;
+  return true;
+}
+
+void VulkanSharedMemory::BumpContentGenerations(uint32_t start, uint32_t length) {
+  if (page_content_generations_.empty() || !length || start >= kBufferSize) {
+    return;
+  }
+  length = std::min(length, kBufferSize - start);
+  uint32_t page_last = (start + (length - 1)) >> page_size_log2();
+  for (uint32_t page = start >> page_size_log2(); page <= page_last; ++page) {
+    ++page_content_generations_[page];
+  }
+}
+
+namespace {
+// 16 MB with 16 KB pages.
+constexpr uint32_t kContentCacheSlotCount = 1024;
+constexpr uint32_t kContentCacheWanted = uint32_t(1) << 31;
+}  // namespace
+
+void VulkanSharedMemory::CacheUploadedContent(uint32_t page, const uint8_t* data) {
+  uint32_t& page_slot = page_content_cache_slots_[page];
+  if (!(page_slot & ~kContentCacheWanted)) {
+    if (content_cache_slots_.empty()) {
+      content_cache_slots_.resize(kContentCacheSlotCount);
+      content_cache_data_.resize(size_t(kContentCacheSlotCount) << page_size_log2());
+    }
+    // Round robin: the dynamic pages this is for are uploaded every frame.
+    uint32_t slot = content_cache_next_slot_;
+    content_cache_next_slot_ = (slot + 1) % kContentCacheSlotCount;
+    ContentCacheSlot& evicted = content_cache_slots_[slot];
+    if (evicted.page != UINT32_MAX) {
+      page_content_cache_slots_[evicted.page] &= kContentCacheWanted;
+    }
+    evicted.page = page;
+    page_slot = kContentCacheWanted | (slot + 1);
+  }
+  uint32_t slot = (page_slot & ~kContentCacheWanted) - 1;
+  content_cache_slots_[slot].generation = page_content_generations_[page];
+  std::memcpy(content_cache_data_.data() + (size_t(slot) << page_size_log2()), data,
+              size_t(1) << page_size_log2());
+}
+
+const uint8_t* VulkanSharedMemory::GetCachedContent(uint32_t page) const {
+  uint32_t page_slot = page_content_cache_slots_[page] & ~kContentCacheWanted;
+  if (!page_slot) {
+    return nullptr;
+  }
+  const ContentCacheSlot& slot = content_cache_slots_[page_slot - 1];
+  if (slot.page != page || slot.generation != page_content_generations_[page]) {
+    return nullptr;
+  }
+  return content_cache_data_.data() + (size_t(page_slot - 1) << page_size_log2());
+}
+
+uint32_t VulkanSharedMemory::CheckReadPageUploads() {
+  uint32_t page_size_log2_value = page_size_log2();
+  bool used_cache = false;
+  for (const StagedUpload& staged : staged_uploads_) {
+    uint32_t page_first = uint32_t(staged.region.dstOffset >> page_size_log2_value);
+    uint32_t page_count = uint32_t(staged.region.size >> page_size_log2_value);
+    for (uint32_t i = 0; i < page_count; ++i) {
+      uint32_t page = page_first + i;
+      if (!(pages_used_in_submission_[page >> 6] & (uint64_t(1) << (page & 63)))) {
+        continue;
+      }
+      if (pages_written_submission_ == pages_used_submission_ &&
+          !pages_written_in_submission_.empty() &&
+          (pages_written_in_submission_[page >> 6] & (uint64_t(1) << (page & 63)))) {
+        return 1;
+      }
+      uint32_t begin, end;
+      if (!GetPageReadSpan(page, begin, end)) {
+        // Used only by earlier hoisted uploads, which this one supersedes.
+        continue;
+      }
+      // What the reads see: the page's hoisted upload earlier in this
+      // submission, otherwise its latest upload in an earlier one (cached
+      // for pages that needed it before; the generation tells that nothing
+      // uploaded or GPU-wrote it since).
+      const PageHoistedUpload& previous = page_hoisted_uploads_[page];
+      const uint8_t* previous_data = nullptr;
+      if (previous.submission == pages_used_submission_ && previous.data) {
+        previous_data = previous.data;
+      } else if (!page_content_cache_slots_.empty() &&
+                 REXCVAR_GET(vulkan_hoist_uploads_of_read_pages_cache)) {
+        previous_data = GetCachedContent(page);
+        if (previous_data) {
+          used_cache = true;
+        } else {
+          page_content_cache_slots_[page] |= kContentCacheWanted;
+        }
+      }
+      if (!previous_data) {
+        return 2;
+      }
+      const uint8_t* data = staged.data + (size_t(i) << page_size_log2_value);
+      if (std::memcmp(previous_data + begin, data + begin, end - begin)) {
+        return 3;
+      }
+    }
+  }
+  if (used_cache) {
+    ++read_page_uploads_hoisted_from_cache_;
+  }
+  return 0;
+}
+
+bool VulkanSharedMemory::ArePagesUsedInSubmission(uint32_t page_first, uint32_t page_count) {
+  UpdatePagesUsedSubmission();
+  uint32_t page_end = std::min(page_first + page_count, kBufferSize >> page_size_log2());
+  for (uint32_t page = page_first; page < page_end;) {
+    uint32_t bit = page & 63;
+    uint32_t count = std::min(64 - bit, page_end - page);
+    uint64_t mask = count == 64 ? ~uint64_t(0) : ((uint64_t(1) << count) - 1) << bit;
+    if (pages_used_in_submission_[page >> 6] & mask) {
+      return true;
+    }
+    page += count;
+  }
+  return false;
+}
+
+void VulkanSharedMemory::MarkBytesWrittenInSubmission(uint32_t start, uint32_t length) {
+  if (!length) {
+    return;
+  }
+  BumpContentGenerations(start, length);
+  uint64_t submission = command_processor_.GetCurrentSubmission();
+  size_t word_count = ((kBufferSize >> page_size_log2()) + 63) / 64;
+  if (pages_written_submission_ != submission || pages_written_in_submission_.size() != word_count) {
+    pages_written_submission_ = submission;
+    pages_written_in_submission_.assign(word_count, 0);
+  }
+  uint32_t page_end =
+      std::min(uint32_t((uint64_t(start) + length - 1) >> page_size_log2()) + 1,
+               kBufferSize >> page_size_log2());
+  for (uint32_t page = start >> page_size_log2(); page < page_end;) {
+    uint32_t bit = page & 63;
+    uint32_t count = std::min(64 - bit, page_end - page);
+    uint64_t mask = count == 64 ? ~uint64_t(0) : ((uint64_t(1) << count) - 1) << bit;
+    pages_written_in_submission_[page >> 6] |= mask;
+    page += count;
+  }
+}
+
+bool VulkanSharedMemory::AreBytesWrittenInSubmission(uint32_t start, uint32_t length) {
+  if (!length || pages_written_submission_ != command_processor_.GetCurrentSubmission() ||
+      pages_written_in_submission_.empty()) {
+    return false;
+  }
+  uint32_t page_end =
+      std::min(uint32_t((uint64_t(start) + length - 1) >> page_size_log2()) + 1,
+               kBufferSize >> page_size_log2());
+  for (uint32_t page = start >> page_size_log2(); page < page_end;) {
+    uint32_t bit = page & 63;
+    uint32_t count = std::min(64 - bit, page_end - page);
+    uint64_t mask = count == 64 ? ~uint64_t(0) : ((uint64_t(1) << count) - 1) << bit;
+    if (pages_written_in_submission_[page >> 6] & mask) {
+      return true;
+    }
+    page += count;
+  }
+  return false;
+}
+
+void VulkanSharedMemory::OnRangesRequested(
+    const std::vector<std::pair<uint32_t, uint32_t>>& ranges) {
+  for (const std::pair<uint32_t, uint32_t>& range : ranges) {
+    MarkBytesUsedInSubmission(range.first, range.second);
+  }
+  if (race_page_submission_) {
+    for (const std::pair<uint32_t, uint32_t>& range : ranges) {
+      NoteRangeUsedForRaces(range.first, range.second, request_kind());
+    }
+  }
+}
+
+namespace {
+const char* const kRequestKindNames[] = {"other",   "indices", "vertices",
+                                         "memexport", "texture", "resolve"};
+constexpr uint32_t kRaceRequestKindShift = 29;
+}  // namespace
+
+void VulkanSharedMemory::NoteRangeUsedForRaces(uint32_t start, uint32_t length,
+                                               RequestKind kind) {
+  if (!length || start >= kBufferSize) {
+    return;
+  }
+  length = std::min(length, kBufferSize - start);
+  uint32_t page_size_log2_value = page_size_log2();
+  uint32_t page_mask = (uint32_t(1) << page_size_log2_value) - 1;
+  uint32_t last = start + length - 1;
+  uint32_t page_first = start >> page_size_log2_value;
+  uint32_t page_last = last >> page_size_log2_value;
+  uint64_t submission = command_processor_.GetCurrentSubmission();
+  race_latest_submission_.store(submission, std::memory_order_relaxed);
+  uint32_t request = start | (uint32_t(kind) << kRaceRequestKindShift);
+  for (uint32_t page = page_first; page <= page_last; ++page) {
+    uint32_t span_begin = page == page_first ? (start & page_mask) : 0;
+    uint32_t span_end = page == page_last ? (last & page_mask) + 1 : page_mask + 1;
+    if (race_page_submission_[page].load(std::memory_order_relaxed) == submission) {
+      uint32_t span = race_page_span_[page].load(std::memory_order_relaxed);
+      span_begin = std::min(span_begin, span & 0xFFFF);
+      span_end = std::max(span_end, span >> 16);
+    }
+    race_page_span_[page].store(span_begin | (span_end << 16), std::memory_order_relaxed);
+    race_page_request_[page].store(request, std::memory_order_relaxed);
+    race_page_submission_[page].store(submission, std::memory_order_release);
+  }
+}
+
+namespace {
+// The faulting code and its callers, from the registers saved by the access
+// violation handler of this thread (frame records: [fp] = caller's fp,
+// [fp + 8] = return address).
+void CaptureFaultingWriter(uint64_t (&writer)[8]) {
+  std::memset(writer, 0, sizeof(writer));
+  uint64_t pc, lr, fp;
+  rex::arch::ExceptionHandler::GetLastFaultRegisters(pc, lr, fp);
+  writer[0] = pc;
+  writer[1] = lr;
+#if REX_PLATFORM_MAC
+  uintptr_t stack_top = uintptr_t(pthread_get_stackaddr_np(pthread_self()));
+  uintptr_t stack_bottom = stack_top - pthread_get_stacksize_np(pthread_self());
+  for (size_t i = 2; i < 8; ++i) {
+    if (!fp || (fp & 15) || fp < stack_bottom || fp + 16 > stack_top) {
+      break;
+    }
+    const uint64_t* frame = reinterpret_cast<const uint64_t*>(fp);
+    writer[i] = frame[1];
+    if (frame[0] <= fp) {
+      break;
+    }
+    fp = frame[0];
+  }
+#endif
+}
+
+std::string DescribeCode(uint64_t address) {
+#if REX_PLATFORM_WIN32
+  return fmt::format("0x{:X}", address);
+#else
+  Dl_info info;
+  if (!address || !dladdr(reinterpret_cast<const void*>(address), &info)) {
+    return fmt::format("0x{:X}", address);
+  }
+  if (info.dli_sname) {
+    return fmt::format("{}+0x{:X}", info.dli_sname,
+                       address - reinterpret_cast<uint64_t>(info.dli_saddr));
+  }
+  const char* image = info.dli_fname ? std::strrchr(info.dli_fname, '/') : nullptr;
+  return fmt::format("{}+0x{:X}", image ? image + 1 : "?",
+                     address - reinterpret_cast<uint64_t>(info.dli_fbase));
+#endif
+}
+}  // namespace
+
+void VulkanSharedMemory::OnCpuWrite(uint32_t start, uint32_t length) {
+  if (!race_page_submission_ || !length || start >= kBufferSize) {
+    return;
+  }
+  length = std::min(length, kBufferSize - start);
+  uint32_t page_size_log2_value = page_size_log2();
+  uint32_t page_first = start >> page_size_log2_value;
+  uint32_t page_last = (start + length - 1) >> page_size_log2_value;
+  uint64_t completed = race_completed_submission_.load(std::memory_order_relaxed);
+  std::lock_guard<std::mutex> lock(race_mutex_);
+  ++race_cpu_writes_;
+  for (uint32_t page = page_first; page <= page_last; ++page) {
+    uint64_t submission = race_page_submission_[page].load(std::memory_order_acquire);
+    if (submission <= completed) {
+      continue;
+    }
+    if (race_snapshot_free_slots_.empty()) {
+      ++race_snapshots_dropped_;
+      continue;
+    }
+    RaceSnapshot snapshot;
+    snapshot.page = page;
+    snapshot.submission = submission;
+    snapshot.span = race_page_span_[page].load(std::memory_order_relaxed);
+    snapshot.request = race_page_request_[page].load(std::memory_order_relaxed);
+    snapshot.slot = race_snapshot_free_slots_.back();
+    race_snapshot_free_slots_.pop_back();
+    CaptureFaultingWriter(snapshot.writer);
+    snapshot.newer =
+        uint32_t(race_latest_submission_.load(std::memory_order_relaxed) - submission);
+    snapshot.pending = uint32_t(submission - completed);
+    snapshot.time = std::chrono::steady_clock::now();
+    std::memcpy(race_snapshot_data_.data() + (size_t(snapshot.slot) << page_size_log2_value),
+                memory().TranslatePhysical(page << page_size_log2_value),
+                size_t(1) << page_size_log2_value);
+    race_snapshots_.push_back(snapshot);
+  }
+}
+
+void VulkanSharedMemory::CheckRaces() {
+  uint64_t completed = command_processor_.GetCompletedSubmission();
+  race_completed_submission_.store(completed, std::memory_order_relaxed);
+  uint32_t page_size_log2_value = page_size_log2();
+  std::lock_guard<std::mutex> lock(race_mutex_);
+  size_t kept = 0;
+  for (size_t i = 0; i < race_snapshots_.size(); ++i) {
+    const RaceSnapshot& snapshot = race_snapshots_[i];
+    if (snapshot.submission > completed) {
+      race_snapshots_[kept++] = snapshot;
+      continue;
+    }
+    // The used bytes of the page: before the CPU write vs. now that the GPU
+    // is done with them.
+    uint32_t span_begin = snapshot.span & 0xFFFF, span_end = snapshot.span >> 16;
+    const uint8_t* before =
+        race_snapshot_data_.data() + (size_t(snapshot.slot) << page_size_log2_value);
+    const uint8_t* now = memory().TranslatePhysical(snapshot.page << page_size_log2_value);
+    uint32_t changed_bytes = 0;
+    for (uint32_t j = span_begin; j < span_end; ++j) {
+      changed_bytes += before[j] != now[j];
+    }
+    if (changed_bytes && snapshot.submission != race_wait_last_submission_) {
+      race_wait_last_submission_ = snapshot.submission;
+      double wait_ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() -
+                                                                 snapshot.time)
+                           .count();
+      ++race_wait_count_;
+      race_wait_ms_ += wait_ms;
+      race_wait_max_ms_ = std::max(race_wait_max_ms_, wait_ms);
+    }
+    RacePage& race_page = race_pages_[snapshot.page];
+    race_page.request = snapshot.request;
+    ++race_page.writes;
+    if (changed_bytes) {
+      ++race_page.changed;
+      race_page.changed_bytes_max = std::max(race_page.changed_bytes_max, changed_bytes);
+      std::memcpy(race_page.writer, snapshot.writer, sizeof(race_page.writer));
+      race_page.newer_min = std::min(race_page.newer_min, snapshot.newer);
+      race_page.newer_max = std::max(race_page.newer_max, snapshot.newer);
+      race_page.pending_min = std::min(race_page.pending_min, snapshot.pending);
+      race_page.pending_max = std::max(race_page.pending_max, snapshot.pending);
+    }
+    race_snapshot_free_slots_.push_back(snapshot.slot);
+  }
+  race_snapshots_.resize(kept);
+
+  auto now_time = std::chrono::steady_clock::now();
+  if (now_time - race_last_log_ < std::chrono::seconds(5)) {
+    return;
+  }
+  race_last_log_ = now_time;
+  uint32_t kind_pages[6] = {}, kind_changed[6] = {};
+  std::vector<std::pair<uint32_t, RacePage>> changed_pages;
+  for (const auto& entry : race_pages_) {
+    uint32_t kind = std::min(entry.second.request >> kRaceRequestKindShift, uint32_t(5));
+    ++kind_pages[kind];
+    if (entry.second.changed) {
+      ++kind_changed[kind];
+      changed_pages.push_back(entry);
+    }
+  }
+  std::string kinds;
+  for (uint32_t kind = 0; kind < 6; ++kind) {
+    if (kind_pages[kind]) {
+      kinds += fmt::format(" {} {}/{}", kRequestKindNames[kind], kind_changed[kind],
+                           kind_pages[kind]);
+    }
+  }
+  REXGPU_INFO(
+      "[race] 5 s: {} CPU write faults; {} pages written while a pending submission used them "
+      "(used bytes changed / pages):{}{}",
+      race_cpu_writes_, race_pages_.size(), kinds.empty() ? " none" : kinds,
+      race_snapshots_dropped_ ? fmt::format(" ({} not checked: no free slot)",
+                                            race_snapshots_dropped_)
+                              : std::string());
+  std::sort(changed_pages.begin(), changed_pages.end(), [](const auto& a, const auto& b) {
+    return a.second.changed != b.second.changed ? a.second.changed > b.second.changed
+                                                : a.first < b.first;
+  });
+  for (size_t i = 0; i < std::min(changed_pages.size(), size_t(16)); ++i) {
+    const auto& [page, race_page] = changed_pages[i];
+    REXGPU_INFO("[race]   page 0x{:08X} {} (request at 0x{:08X}): changed {} of {} times, up to {} "
+                "bytes",
+                page << page_size_log2_value,
+                kRequestKindNames[std::min(race_page.request >> kRaceRequestKindShift,
+                                           uint32_t(5))],
+                race_page.request & ((uint32_t(1) << kRaceRequestKindShift) - 1),
+                race_page.changed, race_page.writes, race_page.changed_bytes_max);
+    std::string writer;
+    for (uint64_t address : race_page.writer) {
+      if (address) {
+        writer += (writer.empty() ? "" : " < ") + DescribeCode(address);
+      }
+    }
+    REXGPU_INFO("[race]     written by {}", writer);
+    REXGPU_INFO("[race]     at the write: {}-{} newer submissions recorded, {}-{} submissions "
+                "to complete up to the page's",
+                race_page.newer_min, race_page.newer_max, race_page.pending_min,
+                race_page.pending_max);
+  }
+  REXGPU_INFO("[race] 5 s: {} waits needed (first racing write per submission), {:.0f} ms in "
+              "total, max {:.1f} ms",
+              race_wait_count_, race_wait_ms_, race_wait_max_ms_);
+  race_wait_count_ = 0;
+  race_wait_ms_ = 0.0;
+  race_wait_max_ms_ = 0.0;
+  race_pages_.clear();
+  race_cpu_writes_ = 0;
+  race_snapshots_dropped_ = 0;
+}
+
+void VulkanSharedMemory::UseImpl(Usage usage, std::pair<uint32_t, uint32_t> written_range,
+                                 const DrawReads* draw) {
   written_range.first = std::min(written_range.first, kBufferSize);
   written_range.second = std::min(written_range.second, kBufferSize - written_range.first);
