+          uint32_t(fetch.sign_y), uint32_t(fetch.sign_z), uint32_t(fetch.sign_w),
+          uint32_t(fetch.num_format), uint32_t(fetch.swizzle), int32_t(fetch.exp_adjust),
+          uint32_t(fetch.mag_filter), uint32_t(fetch.min_filter), uint32_t(fetch.mip_filter),
+          uint32_t(fetch.endianness), uint32_t(fetch.pitch) << 5, uint32_t(fetch.mip_min_level),
+          uint32_t(fetch.mip_max_level), fetch.packed_mips ? " packed" : "",
+          uint32_t(fetch.mip_address) << 12, uint32_t(fetch.clamp_x), uint32_t(fetch.clamp_y),
