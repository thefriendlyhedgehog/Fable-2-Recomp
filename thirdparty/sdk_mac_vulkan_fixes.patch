+// The CGDirectDisplayID of the display SDL places the window on (the one
+// containing the center of that display's bounds).
+void UpdatePresentationDisplay(SDL_Window* window) {
+#if REX_PLATFORM_MAC
+  SDL_DisplayID display = SDL_GetDisplayForWindow(window);
+  SDL_Rect bounds;
+  if (!display || !SDL_GetDisplayBounds(display, &bounds)) {
+    return;
+  }
+  CGDirectDisplayID cg_display = 0;
+  uint32_t count = 0;
+  CGPoint center = CGPointMake(bounds.x + bounds.w * 0.5, bounds.y + bounds.h * 0.5);
