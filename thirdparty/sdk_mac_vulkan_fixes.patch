+VkRenderPass VulkanRenderTargetCache::GetPassLogRenderPass(VkRenderPass render_pass,
+                                                           uint32_t index,
+                                                           const std::string& name) {
+  auto copy_it = pass_log_render_passes_.find(std::make_pair(render_pass, index));
+  if (copy_it != pass_log_render_passes_.end()) {
+    return copy_it->second;
+  }
+  VkRenderPass copy = VK_NULL_HANDLE;
+  for (const auto& render_pass_pair : render_passes_) {
+    if (render_pass_pair.second == render_pass && render_pass != VK_NULL_HANDLE) {
+      copy = CreateHostRenderTargetsRenderPass(render_pass_pair.first);
+      break;
+    }
+  }
+  if (copy != VK_NULL_HANDLE) {
+    command_processor_.GetVulkanDevice()->SetObjectName(VK_OBJECT_TYPE_RENDER_PASS, copy,
+                                                        name.c_str());
+  }
+  pass_log_render_passes_.emplace(std::make_pair(render_pass, index), copy);
+  return copy != VK_NULL_HANDLE ? copy : render_pass;
+}
+
+void VulkanRenderTargetCache::DestroyPassLogRenderPasses() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  for (const auto& copy_pair : pass_log_render_passes_) {
+    if (copy_pair.second != VK_NULL_HANDLE) {
+      vulkan_device->functions().vkDestroyRenderPass(vulkan_device->device(), copy_pair.second,
+                                                     nullptr);
+    }
+  }
+  pass_log_render_passes_.clear();
+}
