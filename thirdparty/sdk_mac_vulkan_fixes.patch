+// Long-frame attribution (vulkan_long_frame_log): command processor thread time
+// per area during the current frame. Time is charged to the innermost open
+// Scope only, so nested areas (a resolve inside a draw, a fence wait inside a
+// resolve) are never counted twice. Command processor thread only.
+// Namespace-scope rather than class members, so the classes keep the layout of
+// the SDK release.
+namespace frame_timing {
+enum Area : uint32_t {
+  kDraws,
+  kPipelines,
+  kTextures,
+  kSharedMemory,
+  kResolves,
+  kGpuWaits,
+  kFrameThrottle,
+  kSubmit,
+  kCompletedSubmissions,
+  kSwap,
+  kIdle,
+  kWaitRegMem,
+  kAreaCount,
+};
+// Whether Scopes measure; changed only between frames (EndFrame).
+extern bool enabled;
+extern uint64_t area_ns[kAreaCount];
+// kAreaCount when no Scope is open.
+extern uint32_t current_area;
+extern std::chrono::steady_clock::time_point mark;
+
+// The clock of the Scopes, read twice per draw or so: on macOS
+// mach_absolute_time (a register read) instead of steady_clock, which goes
+// through clock_gettime and mach_continuous_time and is several times slower.
+// Only differences between its values are used.
+#if defined(__APPLE__)
+extern uint64_t mach_ticks_numer, mach_ticks_denom;
+// frame_timing_fast_clock.
+extern bool fast_clock;
+inline std::chrono::steady_clock::time_point Now() {
+  if (!fast_clock) {
+    return std::chrono::steady_clock::now();
+  }
+  return std::chrono::steady_clock::time_point(
+      std::chrono::nanoseconds(mach_absolute_time() * mach_ticks_numer / mach_ticks_denom));
+}
+#else
+inline std::chrono::steady_clock::time_point Now() { return std::chrono::steady_clock::now(); }
+#endif
+
+inline void Charge(std::chrono::steady_clock::time_point now) {
+  if (current_area < kAreaCount) {
+    area_ns[current_area] +=
+        uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(now - mark).count());
+  }
+  mark = now;
+}
+
+class Scope {
+ public:
+  explicit Scope(uint32_t area) : active_(enabled) {
+    if (active_) {
+      Charge(Now());
+      previous_area_ = current_area;
+      current_area = area;
+    }
+  }
+  ~Scope() {
+    if (active_) {
+      Charge(Now());
+      current_area = previous_area_;
+    }
+  }
+  Scope(const Scope&) = delete;
+  Scope& operator=(const Scope&) = delete;
+
+ private:
+  bool active_;
+  uint32_t previous_area_ = kAreaCount;
+};
