+// The faulting code and its callers, from the registers saved by the access
+// violation handler of this thread (frame records: [fp] = caller's fp,
+// [fp + 8] = return address).
+void CaptureFaultingWriter(uint64_t (&writer)[8]) {
+  std::memset(writer, 0, sizeof(writer));
+  uint64_t pc, lr, fp;
+  rex::arch::ExceptionHandler::GetLastFaultRegisters(pc, lr, fp);
+  writer[0] = pc;
+  writer[1] = lr;
+#if REX_PLATFORM_MAC
+  uintptr_t stack_top = uintptr_t(pthread_get_stackaddr_np(pthread_self()));
+  uintptr_t stack_bottom = stack_top - pthread_get_stacksize_np(pthread_self());
+  for (size_t i = 2; i < 8; ++i) {
+    if (!fp || (fp & 15) || fp < stack_bottom || fp + 16 > stack_top) {
+      break;
+    }
+    const uint64_t* frame = reinterpret_cast<const uint64_t*>(fp);
+    writer[i] = frame[1];
+    if (frame[0] <= fp) {
+      break;
+    }
+    fp = frame[0];
+  }
+#endif
