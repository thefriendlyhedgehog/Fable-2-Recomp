+// Untiles the destination (pitch x height from the copy registers) out of the
+// written range; texels outside it are written as zero.
+void WriteResolveDump(const PendingResolveDump& dump) {
+  const FormatInfo* format_info = FormatInfo::Get(dump.format);
+  uint32_t bits_per_pixel = format_info ? format_info->bits_per_pixel : 0;
+  uint32_t bytes_per_pixel_log2;
+  if (!dump.width || !dump.height ||
+      (bits_per_pixel != 8 && bits_per_pixel != 16 && bits_per_pixel != 32 &&
+       bits_per_pixel != 64) ||
+      !rex::bit_scan_forward(bits_per_pixel >> 3, &bytes_per_pixel_log2)) {
+    REXGPU_WARN("[frame] resolve {} to 0x{:08X} not dumped: format {} ({} bpp), {}x{}",
+                dump.resolve_index, dump.dest_base, dump.format, bits_per_pixel, dump.width,
+                dump.height);
+    return;
+  }
+  uint32_t bytes_per_pixel = bits_per_pixel >> 3;
+  const uint8_t* source = static_cast<const uint8_t*>(dump.mapping);
+  std::vector<uint8_t> pixels(size_t(dump.width) * dump.height * bytes_per_pixel, 0);
+  for (uint32_t y = 0; y < dump.height; ++y) {
