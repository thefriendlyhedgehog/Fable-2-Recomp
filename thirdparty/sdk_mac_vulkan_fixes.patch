+// vulkan_debug_dump_resolves: whether the resolve to dest_base is listed.
+bool IsResolveDumpRequested(uint32_t dest_base) {
+  const std::string& list = REXCVAR_GET(vulkan_debug_dump_resolves);
+  size_t pos = 0;
+  while (pos < list.size()) {
+    size_t end = list.find(',', pos);
+    if (end == std::string::npos) {
+      end = list.size();
+    }
+    std::string entry = list.substr(pos, end - pos);
+    pos = end + 1;
+    size_t first = entry.find_first_not_of(" \t");
+    if (first == std::string::npos) {
+      continue;
+    }
+    entry = entry.substr(first, entry.find_last_not_of(" \t") - first + 1);
+    char* parse_end = nullptr;
+    unsigned long long address = std::strtoull(entry.c_str(), &parse_end, 16);
+    if (parse_end && *parse_end == '\0' && address == dest_base) {
+      return true;
+    }
+  }
+  return false;
