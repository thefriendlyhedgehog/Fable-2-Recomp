+void VulkanCommandProcessor::WaitForGpuBeforeGuestVisibleProgress() {
+  auto start = std::chrono::steady_clock::now();
+  // The guest sees this as the GPU having run everything before it: submit
+  // and wait for the host GPU to really have.
+  if (submission_open_ && CanEndSubmissionImmediately()) {
+    EndSubmission(false);
+  }
+  CheckSubmissionFenceAndDeviceLoss(GetCurrentSubmission() - (submission_open_ ? 1 : 0));
+  ++gpu_progress_waits_;
+  gpu_progress_wait_ms_ +=
+      std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+}
+
+void VulkanCommandProcessor::WriteGuestVisibleProgress(uint32_t address, uint32_t value) {
+  QueueGuestVisibleProgress(address, value, -1);
+}
+
+void VulkanCommandProcessor::SignalGuestVisibleInterrupt(uint32_t cpu) {
+  QueueGuestVisibleProgress(0, 0, int32_t(cpu));
+}
+
+void VulkanCommandProcessor::QueueGuestVisibleProgress(uint32_t address, uint32_t value,
+                                                       int32_t interrupt_cpu) {
+  LogGuestVisibleProgressStats();
+  if (REXCVAR_GET(vulkan_gpu_progress_wait)) {
+    WaitForGpuBeforeGuestVisibleProgress();
+  }
+  DeferredGuestProgress progress;
+  progress.address = address;
+  progress.value = value;
+  progress.interrupt_cpu = interrupt_cpu;
+  if (REXCVAR_GET(vulkan_defer_gpu_progress)) {
+    ApplyCompletedGuestVisibleProgress();
+    // The submission with the commands recorded so far.
+    progress.submission = submission_open_ ? GetCurrentSubmission() : GetCurrentSubmission() - 1;
+    if (!deferred_guest_progress_.empty() || progress.submission > submission_completed_) {
+      // Start the host GPU on the commands this waits for now rather than
+      // when the guest stalls on it.
+      if (REXCVAR_GET(vulkan_defer_gpu_progress_submit) && submission_open_ &&
+          progress.submission >= GetCurrentSubmission() && CanEndSubmissionImmediately()) {
+        EndSubmission(false);
+      }
+      progress.queued = std::chrono::steady_clock::now();
+      deferred_guest_progress_.push_back(progress);
+      ++deferred_guest_progress_count_;
+      deferred_guest_progress_max_queued_ =
+          std::max(deferred_guest_progress_max_queued_, deferred_guest_progress_.size());
+      return;
+    }
+  } else if (!deferred_guest_progress_.empty()) {
+    FlushGuestVisibleProgress();
+  }
+  ApplyGuestVisibleProgress(progress);
+}
+
+void VulkanCommandProcessor::ApplyGuestVisibleProgress(const DeferredGuestProgress& progress) {
+  if (progress.interrupt_cpu >= 0) {
+    CommandProcessor::SignalGuestVisibleInterrupt(uint32_t(progress.interrupt_cpu));
+  } else {
+    CommandProcessor::WriteGuestVisibleProgress(progress.address, progress.value);
+  }
+}
+
+void VulkanCommandProcessor::ApplyCompletedGuestVisibleProgress() {
+  if (deferred_guest_progress_.empty()) {
+    return;
+  }
+  CheckSubmissionFenceAndDeviceLoss(0);
+  auto now = std::chrono::steady_clock::now();
+  while (!deferred_guest_progress_.empty() &&
+         deferred_guest_progress_.front().submission <= submission_completed_) {
+    // Copied: applying an interrupt may run guest code that queues more.
+    DeferredGuestProgress progress = deferred_guest_progress_.front();
+    deferred_guest_progress_.pop_front();
+    double delay_ms = std::chrono::duration<double, std::milli>(now - progress.queued).count();
+    deferred_guest_progress_delay_ms_ += delay_ms;
+    deferred_guest_progress_delay_max_ms_ =
+        std::max(deferred_guest_progress_delay_max_ms_, delay_ms);
+    ++deferred_guest_progress_applied_;
+    ApplyGuestVisibleProgress(progress);
+  }
+}
+
+void VulkanCommandProcessor::FlushGuestVisibleProgress() {
+  if (deferred_guest_progress_.empty()) {
+    return;
+  }
+  if (submission_open_ && deferred_guest_progress_.back().submission >= GetCurrentSubmission()) {
+    if (!CanEndSubmissionImmediately()) {
+      // Cannot be submitted yet: let the guest see it now rather than never.
+      deferred_guest_progress_forced_ += uint32_t(deferred_guest_progress_.size());
+      while (!deferred_guest_progress_.empty()) {
+        DeferredGuestProgress progress = deferred_guest_progress_.front();
+        deferred_guest_progress_.pop_front();
+        ApplyGuestVisibleProgress(progress);
+      }
+      return;
+    }
+    EndSubmission(false);
+  }
+  CheckSubmissionFenceAndDeviceLoss(deferred_guest_progress_.back().submission);
+  ApplyCompletedGuestVisibleProgress();
+}
+
+void VulkanCommandProcessor::OnIdle() {
+  auto now = std::chrono::steady_clock::now();
+  if (idle_last_ != std::chrono::steady_clock::time_point()) {
+    double ms = std::chrono::duration<double, std::milli>(now - idle_last_).count();
+    idle_ms_ += ms;
+    if (!deferred_guest_progress_.empty()) {
+      const DeferredGuestProgress& front = deferred_guest_progress_.front();
+      idle_blocked_ms_[front.interrupt_cpu >= 0 ? 0xFFFFFFF0u + uint32_t(front.interrupt_cpu)
+                                                : front.address] += ms;
+    }
+  }
+  idle_last_ = now;
+  if (deferred_guest_progress_.empty()) {
+    return;
+  }
+  // Nothing else to record: submit what the delayed progress waits for, so the
+  // host GPU can complete it, and let through what has completed.
+  if (submission_open_ && deferred_guest_progress_.back().submission >= GetCurrentSubmission() &&
+      CanEndSubmissionImmediately()) {
+    EndSubmission(false);
+  }
+  ApplyCompletedGuestVisibleProgress();
+}
+
+void VulkanCommandProcessor::PrepareForWait() {
+  CommandProcessor::PrepareForWait();
+  idle_last_ = std::chrono::steady_clock::time_point();
+  OnIdle();
+}
+
+void VulkanCommandProcessor::ReturnFromWait() {
+  OnIdle();
+  idle_last_ = std::chrono::steady_clock::time_point();
+  CommandProcessor::ReturnFromWait();
+}
+
+void VulkanCommandProcessor::LogGuestVisibleProgressStats() {
+  auto now = std::chrono::steady_clock::now();
+  if (gpu_progress_last_log_ == std::chrono::steady_clock::time_point()) {
+    gpu_progress_last_log_ = now;
+    return;
+  }
+  if (now - gpu_progress_last_log_ < std::chrono::seconds(5)) {
+    return;
+  }
+  gpu_progress_last_log_ = now;
+  if (gpu_progress_waits_) {
+    REXGPU_INFO("[gpu-progress] 5 s: {} waits for the GPU, {:.1f} ms waited", gpu_progress_waits_,
+                gpu_progress_wait_ms_);
+  }
+  if (deferred_guest_progress_count_ || deferred_guest_progress_applied_) {
+    REXGPU_INFO(
+        "[gpu-progress] 5 s: {} delayed, {} applied (delay average {:.1f} ms, max {:.1f} ms), "
+        "up to {} queued, {} let through early (could not submit)",
+        deferred_guest_progress_count_, deferred_guest_progress_applied_,
+        deferred_guest_progress_applied_
+            ? deferred_guest_progress_delay_ms_ / deferred_guest_progress_applied_
+            : 0.0,
+        deferred_guest_progress_delay_max_ms_, deferred_guest_progress_max_queued_,
+        deferred_guest_progress_forced_);
+  }
+  if (idle_ms_ > 0.0) {
+    std::vector<std::pair<double, uint32_t>> blocked;
+    double blocked_total = 0.0;
+    for (const auto& [address, ms] : idle_blocked_ms_) {
+      blocked.emplace_back(ms, address);
+      blocked_total += ms;
+    }
+    std::sort(blocked.rbegin(), blocked.rend());
+    std::string top;
+    for (size_t i = 0; i < std::min(blocked.size(), size_t(6)); ++i) {
+      top += fmt::format(" 0x{:08X} {:.0f} ms", blocked[i].second, blocked[i].first);
+    }
+    REXGPU_INFO("[gpu-progress] 5 s: command processor idle {:.0f} ms, {:.0f} ms of it with "
+                "progress delayed; by first delayed write:{}",
+                idle_ms_, blocked_total, top.empty() ? " none" : top);
+  }
+  idle_ms_ = 0.0;
+  idle_blocked_ms_.clear();
+  gpu_progress_waits_ = 0;
+  gpu_progress_wait_ms_ = 0.0;
+  deferred_guest_progress_count_ = 0;
+  deferred_guest_progress_applied_ = 0;
+  deferred_guest_progress_max_queued_ = deferred_guest_progress_.size();
+  deferred_guest_progress_delay_ms_ = 0.0;
+  deferred_guest_progress_delay_max_ms_ = 0.0;
+  deferred_guest_progress_forced_ = 0;
+}
