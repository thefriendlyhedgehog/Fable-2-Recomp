+
+// Writes the dumps whose submissions have completed (all of them with
+// destroy_all, after the queue has been drained) and frees their buffers.
+void ProcessPendingResolveDumps(const ui::vulkan::VulkanDevice* vulkan_device,
+                                uint64_t completed_submission, bool destroy_all) {
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  for (auto it = pending_resolve_dumps.begin(); it != pending_resolve_dumps.end();) {
+    if (!destroy_all && it->submission > completed_submission) {
+      ++it;
+      continue;
+    }
+    if (it->submission <= completed_submission) {
+      VkMappedMemoryRange range = {};
+      range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+      range.memory = it->memory;
+      range.offset = 0;
+      range.size = VK_WHOLE_SIZE;
+      dfn.vkInvalidateMappedMemoryRanges(device, 1, &range);
+      WriteResolveDump(*it);
+    }
+    dfn.vkUnmapMemory(device, it->memory);
+    dfn.vkDestroyBuffer(device, it->buffer, nullptr);
+    dfn.vkFreeMemory(device, it->memory, nullptr);
+    it = pending_resolve_dumps.erase(it);
+  }
+}
