+bool VulkanPipelineCache::WaitForPipeline(void* handle, uint32_t timeout_ms) {
+  auto* target = reinterpret_cast<const Pipeline*>(handle);
+  if (!target) {
+    return false;
+  }
+  // Done once the real pipeline replaced the placeholder, or once creating it
+  // failed (the placeholder is then kept, or the pipeline cleared).
+  auto target_ready = [target]() {
+    return !target->is_placeholder.load(std::memory_order_acquire) ||
+           target->pipeline.load(std::memory_order_acquire) == VK_NULL_HANDLE;
+  };
+  if (target_ready()) {
+    return true;
+  }
+  if (creation_threads_.empty()) {
+    return false;
+  }
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(timeout_ms);
+  while (!target_ready() && std::chrono::steady_clock::now() < deadline) {
+    PipelineCreationArguments creation_arguments;
+    bool have_creation_arguments = false;
+    {
+      std::lock_guard<std::mutex> lock(creation_request_lock_);
+      if (!creation_queue_.empty()) {
+        creation_arguments = creation_queue_.top();
+        creation_queue_.pop();
+        have_creation_arguments = true;
+      }
+    }
+    if (!have_creation_arguments) {
+      // A creation thread has the pipeline; it clears is_placeholder when done
+      // (or when the creation fails).
+      std::this_thread::sleep_for(std::chrono::microseconds(250));
+      continue;
+    }
+    // Same as CreationThread.
+    if (!EnsurePipelineCreated(creation_arguments)) {
+      bool has_placeholder =
+          creation_arguments.pipeline->second.is_placeholder.load(std::memory_order_acquire);
+      VkPipeline pipeline =
+          creation_arguments.pipeline->second.pipeline.load(std::memory_order_acquire);
+      if (has_placeholder && pipeline != VK_NULL_HANDLE) {
+        creation_arguments.pipeline->second.is_placeholder.store(false, std::memory_order_release);
+      } else {
+        creation_arguments.pipeline->second.pipeline.store(VK_NULL_HANDLE,
+                                                           std::memory_order_release);
+      }
+    }
+  }
+  return target_ready();
+}
