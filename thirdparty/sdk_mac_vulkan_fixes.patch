+    ys[i] = position[1] / xy_w * y_scale + y_offset + pixel_offset_y;
+    zs[i] = z;
+    std::memcpy(interpolators[i], position_export_sink.interpolators, sizeof(interpolators[i]));
+    for (uint32_t j = 0; j < xenos::kMaxInterpolators; ++j) {
+      if (position_export_sink.interpolator_masks[j]) {
+        written_interpolators |= uint32_t(1) << j;
