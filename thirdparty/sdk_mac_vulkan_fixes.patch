+bool VulkanTextureCache::PrepareResolveIntoTexture(uint32_t dest_base, uint32_t dest_bpp_log2,
+                                                   uint32_t dest_pitch_texels, uint32_t dest_x,
+                                                   uint32_t dest_y, uint32_t width,
+                                                   uint32_t height,
+                                                   ResolveIntoTexture& target_out,
+                                                   const char** reason_out) {
+  const char* reason_dummy;
+  const char*& reason = reason_out ? *reason_out : reason_dummy;
+  reason = "no storage texture at the address";
+  if (!REXCVAR_GET(vulkan_resolve_into_texture) || (dest_base & 0xFFF)) {
+    reason = "off or address not page-aligned";
+    return false;
+  }
+  if (dest_base == uint32_t(REXCVAR_GET(debug_resolve_into_texture_exclude))) {
+    reason = "excluded (debug_resolve_into_texture_exclude)";
+    return false;
+  }
+  auto range = storage_textures_by_base_page_.equal_range(dest_base >> 12);
+  if (range.first == range.second) {
+    // A texture created before its memory was GPU-written has no storage
+    // image: retired, so the next request creates it with one.
+    if (REXCVAR_GET(vulkan_resolve_into_texture_recreate)) {
+      RetireTexturesForStorageAt(dest_base >> 12);
+    }
+    return false;
+  }
+  VulkanTexture* target = nullptr;
+  uint32_t target_level = 0;
+  uint32_t target_convert = 0;
+  {
+    auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+    for (auto it = range.first; it != range.second; ++it) {
+      VulkanTexture& texture = *it->second;
+      const TextureKey& key = texture.key();
+      if (key.dimension != xenos::DataDimension::k2DOrStacked ||
+          key.GetDepthOrArraySize() != 1 || !key.tiled || key.scaled_resolve) {
+        reason = "texture not 2D tiled";
+        continue;
+      }
+      uint32_t level = UINT32_MAX;
+      ForEachResolvableLevel(texture, [&](uint32_t level_index, uint32_t level_address) {
+        if (level_address == dest_base) {
+          level = level_index;
+        }
+      });
+      if (level == UINT32_MAX) {
+        reason = "no level at the address outside the packed mips";
+        continue;
+      }
+      // The load the texture would get (as in
+      // LoadTextureDataFromResidentMemoryImpl).
+      const HostFormatPair& host_format_pair = GetHostFormatPair(key);
+      bool host_format_is_signed =
+          IsSignedVersionSeparateForFormat(key)
+              ? bool(key.signed_separate)
+              : host_format_pair.format_unsigned.load_shader == kLoadShaderIndexUnknown;
+      const HostFormat& host_format =
+          host_format_is_signed ? host_format_pair.format_signed : host_format_pair.format_unsigned;
+      uint32_t load_bpp_log2 = UINT32_MAX;
+      uint32_t convert = 0;
+      switch (host_format.load_shader) {
+        case kLoadShaderIndex8bpb:
+          load_bpp_log2 = 0;
+          break;
+        case kLoadShaderIndex16bpb:
+          load_bpp_log2 = 1;
+          break;
+        case kLoadShaderIndexR5G5B5A1ToB5G5R5A1:
+          load_bpp_log2 = 1;
+          convert = 4;
+          break;
+        case kLoadShaderIndex32bpb:
+          if (host_format.format != VK_FORMAT_R16G16B16A16_SFLOAT) {
+            load_bpp_log2 = 2;
+          }
+          break;
+        case kLoadShaderIndexDepthFloat:
+          load_bpp_log2 = 2;
+          convert = 4;
+          break;
+        case kLoadShaderIndex64bpb:
+          load_bpp_log2 = 3;
+          break;
+        default:
+          break;
+      }
+      if (load_bpp_log2 == UINT32_MAX ||
+          load_image_pipelines_[host_format.load_shader] == VK_NULL_HANDLE) {
+        reason = "texture load not into the image";
+        continue;
+      }
+      if (load_bpp_log2 != dest_bpp_log2) {
+        reason = "texel size differs";
+        continue;
+      }
+      // Same addresses: the level's guest pitch in texels is the
+      // destination's.
+      const texture_util::TextureGuestLayout::Level& level_layout =
+          level ? texture.guest_layout().mips[level] : texture.guest_layout().base;
+      if (level_layout.row_pitch_bytes != dest_pitch_texels << dest_bpp_log2) {
+        reason = "pitch differs";
+        continue;
+      }
+      if (level) {
+        // The other levels in the mips must already be up to date.
+        if (texture.mips_outdated(global_lock)) {
+          reason = "mips outdated";
+          continue;
+        }
+      } else {
+        // All texels written, or the others already up to date.
+        bool covered = dest_x == 0 && dest_y == 0 && width >= key.GetWidth() &&
+                       height >= key.GetHeight();
+        if (!covered && texture.base_outdated(global_lock)) {
+          reason = "not covered and outdated";
+          continue;
+        }
+      }
+      // The one used last, if several formats share the memory.
+      if (!target || texture.last_usage_time() > target->last_usage_time()) {
+        target = &texture;
+        target_level = level;
+        target_convert = convert;
+      }
+    }
+  }
+  if (!target) {
+    return false;
+  }
+  VkDescriptorSet storage_descriptor_set = target->GetStorageDescriptorSet(target_level);
+  if (storage_descriptor_set == VK_NULL_HANDLE) {
+    reason = "no storage descriptor";
+    return false;
+  }
+  reason = target_level ? "into texture mip" : "into texture";
+  // To the storage image layout after the image's earlier use, as for a load.
+  VulkanTexture::Usage old_usage = target->SetUsage(VulkanTexture::Usage::kComputeWrite);
+  VkPipelineStageFlags src_stage_mask, dst_stage_mask;
+  VkAccessFlags src_access_mask, dst_access_mask;
+  VkImageLayout old_layout, new_layout;
+  GetTextureUsageMasks(old_usage, src_stage_mask, src_access_mask, old_layout);
+  GetTextureUsageMasks(VulkanTexture::Usage::kComputeWrite, dst_stage_mask, dst_access_mask,
+                       new_layout);
+  command_processor_.PushImageMemoryBarrier(
+      target->image(), ui::vulkan::util::InitializeSubresourceRange(), src_stage_mask,
+      dst_stage_mask, src_access_mask, dst_access_mask, old_layout, new_layout,
+      VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, false);
+  target->SetMainStreamSubmission(command_processor_.GetCurrentSubmission());
+  target->MarkAsUsed();
+  const TextureKey& target_key = target->key();
+  uint32_t level_width = std::max(target_key.GetWidth() >> target_level, uint32_t(1));
+  uint32_t level_height = std::max(target_key.GetHeight() >> target_level, uint32_t(1));
+  target_out.texture = target;
+  target_out.storage_descriptor_set = storage_descriptor_set;
+  target_out.texture_info = uint32_t(target_key.endianness) | target_convert;
+  target_out.texture_size_minus_1 = (level_width - 1) | ((level_height - 1) << 16);
+  target_out.mips = target_level != 0;
+  return true;
+}
+
+void VulkanTextureCache::CompleteResolveIntoTexture(const ResolveIntoTexture& target) {
+  if (!target.texture) {
+    return;
+  }
+  VulkanTexture& texture = *target.texture;
+  texture.SetGuestDataHash(false);
+  auto global_lock = rex::thread::global_critical_region::AcquireDirect();
+  bool was_outdated =
+      target.mips ? texture.mips_outdated(global_lock) : texture.base_outdated(global_lock);
+  if (was_outdated && texture.MakePartUpToDateAndWatch(global_lock, target.mips)) {
+    ++resolve_into_texture_count_;
+    texture.LogAction("Resolved into");
+  } else if (REXCVAR_GET(texture_load_log)) {
+    const TextureKey& key = texture.key();
+    REXGPU_INFO("[texture loads] resolve into {:08X} {}x{} fmt {}{}: {}", key.base_page << 12,
+                key.GetWidth(), key.GetHeight(), uint32_t(key.format),
+                target.mips ? " mips" : "",
+                was_outdated ? "still outdated (range not valid)" : "was not outdated");
+  }
+}
+
+VkFormat VulkanTextureCache::GetLoadToImageStorageFormat(LoadShaderIndex load_shader) {
+  switch (load_shader) {
+    case kLoadShaderIndex8bpb:
+      return VK_FORMAT_R8_UINT;
+    case kLoadShaderIndex16bpb:
+    case kLoadShaderIndexR5G5B5A1ToB5G5R5A1:
+      return VK_FORMAT_R16_UINT;
+    case kLoadShaderIndex32bpb:
+    case kLoadShaderIndexDepthFloat:
+      return VK_FORMAT_R32_UINT;
+    case kLoadShaderIndex64bpb:
+      return VK_FORMAT_R32G32_UINT;
+    default:
+      return VK_FORMAT_UNDEFINED;
   }
 }
 
