+void VulkanCommandProcessor::LogGpuPassTime() {
+  // Per frame of the frames timed. MoltenVK resolves each timestamp written
+  // outside an encoder in a blit pass of its own that waits for the encoders
+  // before it, so in a timed frame the passes run one after another, with
+  // these blit passes in between: the times are what each pass costs on its
+  // own, and the frame takes longer (shown as the timed frames' GPU time).
+  uint32_t frames = gpu_pass_time_frames_;
+  if (gpu_pass_time_totals_.empty() || !frames) {
+    return;
+  }
+  // By kind: transfers, the swap, and the other passes by their draw count.
+  static const char* const kKindNames[] = {"transfers",
+                                           "swap",
+                                           "passes with 0-2 draws",
+                                           "passes with 3-99 draws",
+                                           "passes with 100+ draws",
+                                           "resolves"};
+  constexpr size_t kKindCount = rex::countof(kKindNames);
+  double kind_ms[kKindCount] = {};
+  double kind_count[kKindCount] = {};
+  double passes_ms = 0.0;
+  std::vector<std::pair<double, const std::string*>> by_time;
+  for (const auto& entry : gpu_pass_time_totals_) {
+    const GpuPassTimeTotal& total = entry.second;
+    double ms = double(total.ns) * 1e-6 / frames;
+    passes_ms += ms;
+    size_t kind;
+    if (entry.first.rfind("transfer", 0) == 0) {
+      kind = 0;
+    } else if (entry.first.rfind("resolve", 0) == 0) {
+      kind = 5;
+    } else if (entry.first.rfind("swap", 0) == 0) {
+      kind = 1;
+    } else {
+      uint64_t draws = total.draws / std::max(total.count, uint32_t(1));
+      kind = draws <= 2 ? 2 : (draws < 100 ? 3 : 4);
+    }
+    kind_ms[kind] += ms;
+    kind_count[kind] += double(total.count) / frames;
+    by_time.emplace_back(ms, &entry.first);
+  }
+  std::string kinds;
+  for (size_t i = 0; i < kKindCount; ++i) {
+    kinds += fmt::format("{}{}: {:.1f} x {:.2f} ms", i ? ", " : "", kKindNames[i], kind_count[i],
+                         kind_ms[i]);
+  }
+  double timed_frame_ms = double(gpu_pass_time_submission_ns_) * 1e-6 / frames;
+  REXGPU_INFO(
+      "GPU passes ({} frames timed, {:.2f} ms/frame with the timing): {:.2f} ms/frame in render "
+      "passes and resolves, {:.2f} ms outside them (compute, copies, barriers, timestamps); {} ({} "
+      "submissions measured, {} not)",
+      frames, timed_frame_ms, passes_ms, std::max(timed_frame_ms - passes_ms, 0.0), kinds,
+      gpu_pass_time_submissions_, gpu_pass_time_submissions_missed_);
+  std::sort(by_time.begin(), by_time.end(),
+            [](const auto& a, const auto& b) { return a.first > b.first; });
+  for (size_t i = 0; i < std::min(by_time.size(), size_t(12)); ++i) {
+    const GpuPassTimeTotal& total = gpu_pass_time_totals_[*by_time[i].second];
+    REXGPU_INFO("GPU passes: {:5.2f} ms/frame, {:.1f}/frame, {} draws each: {}", by_time[i].first,
+                double(total.count) / frames, total.draws / std::max(total.count, uint32_t(1)),
+                *by_time[i].second);
+  }
+  // Every resolve, so their own cost can be set against their size.
+  for (const auto& entry : by_time) {
+    if (entry.second->rfind("resolve", 0) != 0) {
+      continue;
+    }
+    const GpuPassTimeTotal& total = gpu_pass_time_totals_[*entry.second];
+    double count = double(total.count) / frames;
+    REXGPU_INFO("GPU resolves: {:5.3f} ms/frame, {:.1f}/frame, {:4.0f} us each: {}", entry.first,
+                count, count > 0.0 ? entry.first * 1000.0 / count : 0.0, *entry.second);
+  }
+}
