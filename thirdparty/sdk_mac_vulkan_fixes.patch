+void VulkanCommandProcessor::ReadCompletedGpuTime() {
+  if (gpu_time_query_pool_ == VK_NULL_HANDLE) {
+    return;
+  }
+  const VkDevice device = GetVulkanDevice()->device();
+  while (!gpu_time_pending_.empty() && gpu_time_pending_.front().first <= submission_completed_) {
+    uint64_t submission = gpu_time_pending_.front().first;
+    uint32_t slot = gpu_time_pending_.front().second;
+    gpu_time_pending_.pop_front();
+    uint64_t ticks[2];
+    if (gpu_time_get_results_(device, gpu_time_query_pool_, 2 * slot, 2, sizeof(ticks), ticks,
+                              sizeof(uint64_t), VK_QUERY_RESULT_64_BIT) != VK_SUCCESS) {
+      ++gpu_time_submissions_missed_;
+      continue;
+    }
+    uint64_t elapsed_ticks = (ticks[1] - ticks[0]) & gpu_time_tick_mask_;
+    uint64_t elapsed_ns = uint64_t(double(elapsed_ticks) * gpu_time_ns_per_tick_);
+    gpu_time_ns_ += elapsed_ns;
+    ++gpu_time_submissions_;
+    for (GpuPassTimeSubmission& pass_time_submission : gpu_pass_time_pending_) {
+      if (pass_time_submission.submission == submission) {
+        pass_time_submission.submission_ns = elapsed_ns;
+        break;
+      }
+    }
+  }
+  std::vector<uint64_t> pass_ticks;
+  while (!gpu_pass_time_pending_.empty() &&
+         gpu_pass_time_pending_.front().submission <= submission_completed_) {
+    const GpuPassTimeSubmission& pending = gpu_pass_time_pending_.front();
+    uint32_t query_count = 2 * uint32_t(pending.passes.size());
+    pass_ticks.resize(query_count);
+    if (gpu_time_get_results_(device, gpu_pass_time_query_pool_, pending.first_query,
+                              query_count, sizeof(uint64_t) * query_count, pass_ticks.data(),
+                              sizeof(uint64_t), VK_QUERY_RESULT_64_BIT) == VK_SUCCESS) {
+      for (size_t i = 0; i < pending.passes.size(); ++i) {
+        uint64_t elapsed_ticks = (pass_ticks[2 * i + 1] - pass_ticks[2 * i]) & gpu_time_tick_mask_;
+        GpuPassTimeTotal& total = gpu_pass_time_totals_[pending.passes[i].first];
+        total.ns += uint64_t(double(elapsed_ticks) * gpu_time_ns_per_tick_);
+        ++total.count;
+        total.draws += pending.passes[i].second;
+      }
+      gpu_pass_time_submission_ns_ += pending.submission_ns;
+      ++gpu_pass_time_submissions_;
+    } else {
+      ++gpu_pass_time_submissions_missed_;
+    }
+    gpu_pass_time_pending_.pop_front();
+  }
+}
