+void VulkanCommandProcessor::LogFrameReportDraw(
+    xenos::PrimitiveType prim_type, uint32_t index_count, const VulkanShader* vertex_shader,
+    const VulkanShader* pixel_shader, reg::RB_DEPTHCONTROL normalized_depth_control,
+    uint32_t normalized_color_mask, uint32_t pipeline_sample_count_log2, bool pass_restarted) {
+  const RegisterFile& regs = *register_file_;
+  auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  auto color_control = regs.Get<reg::RB_COLORCONTROL>();
+  auto mode_control = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  std::string targets;
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    uint32_t mask = (normalized_color_mask >> (i * 4)) & 0xF;
+    if (!mask) {
+      continue;
+    }
+    auto color_info = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[i]);
+    auto blend_control =
+        regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[i]);
+    targets += fmt::format(" rt{} fmt {} base {} mask {:X} blend {:08X};", i,
+                           uint32_t(color_info.color_format), uint32_t(color_info.color_base), mask,
+                           blend_control.value);
+  }
+  auto depth_info = regs.Get<reg::RB_DEPTH_INFO>();
+  // The textures the shaders sample: fetch constant, guest address, format,
+  // size, tiling, signedness, swizzle and filters, once per fetch constant.
+  std::string textures;
+  uint32_t textures_listed = 0;
+  for (const VulkanShader* shader : {vertex_shader, pixel_shader}) {
+    if (!shader) {
+      continue;
+    }
+    for (const Shader::TextureBinding& binding : shader->texture_bindings()) {
+      if (textures_listed & (UINT32_C(1) << binding.fetch_constant)) {
+        continue;
+      }
+      textures_listed |= UINT32_C(1) << binding.fetch_constant;
+      xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(binding.fetch_constant);
+      uint32_t width = 0, height = 0, depth = 1;
+      switch (fetch.dimension) {
+        case xenos::DataDimension::k1D:
+          width = fetch.size_1d.width + 1;
+          height = 1;
+          break;
+        case xenos::DataDimension::k2DOrStacked:
+          width = fetch.size_2d.width + 1;
+          height = fetch.size_2d.height + 1;
+          depth = fetch.stacked ? fetch.size_2d.stack_depth + 1 : 1;
+          break;
+        case xenos::DataDimension::k3D:
+          width = fetch.size_3d.width + 1;
+          height = fetch.size_3d.height + 1;
+          depth = fetch.size_3d.depth + 1;
+          break;
+        case xenos::DataDimension::kCube:
+          width = fetch.size_2d.width + 1;
+          height = fetch.size_2d.height + 1;
+          depth = 6;
+          break;
+      }
+      textures += fmt::format(
+          " {}t{}: 0x{:08X} fmt {} {}x{}x{} dim {} {} sign {}{}{}{} num {} swz {:03X} exp {} "
+          "filt {}{}{} endian {} pitch {} mips {}-{}{} mipaddr 0x{:08X} clamp {}{}{} border {};",
+          shader == vertex_shader ? "v" : "", binding.fetch_constant,
+          uint32_t(fetch.base_address) << 12, uint32_t(fetch.format), width, height, depth,
+          uint32_t(fetch.dimension), fetch.tiled ? "tiled" : "linear", uint32_t(fetch.sign_x),
+          uint32_t(fetch.sign_y), uint32_t(fetch.sign_z), uint32_t(fetch.sign_w),
+          uint32_t(fetch.num_format), uint32_t(fetch.swizzle), int32_t(fetch.exp_adjust),
+          uint32_t(fetch.mag_filter), uint32_t(fetch.min_filter), uint32_t(fetch.mip_filter),
+          uint32_t(fetch.endianness), uint32_t(fetch.pitch) << 5, uint32_t(fetch.mip_min_level),
+          uint32_t(fetch.mip_max_level), fetch.packed_mips ? " packed" : "",
+          uint32_t(fetch.mip_address) << 12, uint32_t(fetch.clamp_x), uint32_t(fetch.clamp_y),
+          uint32_t(fetch.clamp_z), uint32_t(fetch.border_color));
+    }
+  }
+  // Patch draws (tessellation): mode (0 discrete, 1 continuous, 2 adaptive) and
+  // the factor range as the host uses it (register + 1).
+  std::string tessellation;
+  if (prim_type == xenos::PrimitiveType::kLinePatch ||
+      prim_type == xenos::PrimitiveType::kTrianglePatch ||
+      prim_type == xenos::PrimitiveType::kQuadPatch) {
+    tessellation = fmt::format(" | tess mode {} factor {}-{}",
+                               uint32_t(regs.Get<reg::VGT_HOS_CNTL>().tess_mode),
+                               regs.Get<float>(XE_GPU_REG_VGT_HOS_MIN_TESS_LEVEL) + 1.0f,
+                               regs.Get<float>(XE_GPU_REG_VGT_HOS_MAX_TESS_LEVEL) + 1.0f);
+  }
+  REXGPU_INFO(
+      "[frame] draw {}: vs {:016X} ps {:016X} prim {} count {} ({}){} | msaa {}x (pipeline {}x) "
+      "pitch {} |{} depth fmt {} base {} test {} func {} write {} stencil {} | alpha test {} "
+      "func {} to-coverage {} | cull {}{} poly offset {}{}{} | polymode {} {}{} | tex{}",
+      frame_report_draws_++, vertex_shader ? vertex_shader->ucode_data_hash() : 0,
+      pixel_shader ? pixel_shader->ucode_data_hash() : 0, uint32_t(prim_type), index_count,
+      draw_packet::is_draw_indx_2 ? "DRAW_INDX_2" : "DRAW_INDX", tessellation,
+      1u << uint32_t(surface_info.msaa_samples), 1u << pipeline_sample_count_log2,
+      uint32_t(surface_info.surface_pitch), targets.empty() ? std::string(" no color;") : targets,
+      uint32_t(depth_info.depth_format), uint32_t(depth_info.depth_base),
+      uint32_t(normalized_depth_control.z_enable), uint32_t(normalized_depth_control.zfunc),
+      uint32_t(normalized_depth_control.z_write_enable),
+      uint32_t(normalized_depth_control.stencil_enable), uint32_t(color_control.alpha_test_enable),
+      uint32_t(color_control.alpha_func), uint32_t(color_control.alpha_to_mask_enable),
+      mode_control.cull_front ? "F" : "", mode_control.cull_back ? "B" : "",
+      uint32_t(mode_control.poly_offset_front_enable),
+      uint32_t(mode_control.poly_offset_back_enable), pass_restarted ? " | new pass" : "",
+      uint32_t(mode_control.poly_mode), uint32_t(mode_control.polymode_front_ptype),
+      uint32_t(mode_control.polymode_back_ptype),
+      textures.empty() ? std::string(" none") : textures);
+}
